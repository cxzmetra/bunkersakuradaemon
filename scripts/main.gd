func _reveal_professions() -> void:
	# Start a paced reveal: reveal only the current participant's profession, then wait 10 seconds.
	if is_instance_valid(phase_timer):
		phase_timer.stop()
	revealed_categories.clear()
	revealed_categories.append("Профессия")
	human_revealed_categories.clear()
	discussion_queue.clear()
	discussion_statements.clear()
	discussion_revealed_this_turn.clear()
	discussion_reveal_counts.clear()
	profession_reveal_order.clear()
	profession_reveal_index = 0
	reveal_overlay_queue.clear()
	pending_discussion_after_reveal = false
	pending_vote_after_reveal = false
	for i in range(game_players.size()):
		var person: Dictionary = game_players[i]
		if bool(person.get("alive", true)):
			person["revealed"] = []
			profession_reveal_order.append(i)
		game_players[i] = person
	if profession_reveal_order.is_empty():
		_begin_vote_prep()
		return
	discussion_queue.clear()
	for index in profession_reveal_order:
		discussion_queue.append(str(game_players[index].get("name", "Участник")))
	discussion_turn = 0
	current_bunker_discovery = str(_pick(bunker_discovery_cards))
	game_log.append("Профессии раскрываются по одной с интервалом 10 секунд.")
	game_phase = "profession"
	phase_seconds_left = PROFESSION_REVEAL_INTERVAL
	_show_gameplay()
	_reveal_next_profession()

func _reveal_next_profession() -> void:
	if profession_reveal_index >= profession_reveal_order.size():
		game_phase = "discussion"
		discussion_turn = 0
		phase_seconds_left = configured_turn_seconds
		if is_instance_valid(phase_timer):
			phase_timer.start()
		game_log.append("Все профессии раскрыты. Начинается обсуждение.")
		_show_gameplay()
		return
	var player_index: int = profession_reveal_order[profession_reveal_index]
	var person: Dictionary = game_players[player_index]
	if not bool(person.get("alive", true)):
		profession_reveal_index += 1
		_reveal_next_profession()
		return
	var name := str(person.get("name", "Участник"))
	var value := str(person.get("profession", "Неизвестно"))
	person["revealed"] = ["Профессия"]
	game_players[player_index] = person
	network_last_reveal = {"id":"%d|%s|Профессия|%d" % [game_round, name, Time.get_ticks_msec()], "name":name, "category":"Профессия", "value":value}
	if bool(person.get("is_human", false)) and not human_revealed_categories.has("Профессия"):
		human_revealed_categories.append("Профессия")
	_show_gameplay()
	_show_character_reveal_splash(name, "Профессия", value)
	profession_reveal_index += 1
	if is_instance_valid(phase_timer):
		phase_timer.stop()
	phase_seconds_left = PROFESSION_REVEAL_INTERVAL

func _required_reveals_this_round(person: Dictionary) -> int:
	# Over the configured number of rounds, aim to reveal every card except exactly one.
	var revealed: Array = person.get("revealed", [])
	var total_to_reveal := maxi(0, CARD_CATEGORIES.size() - 2) # profession + ten other cards, one remains hidden
	var additional_opened := 0
	for category in revealed:
		if str(category) != "Профессия": additional_opened += 1
	var remaining := maxi(0, total_to_reveal - additional_opened)
	var rounds_left := maxi(1, configured_round_limit - game_round + 1)
	return mini(2, int(ceil(float(remaining) / float(rounds_left))))

func _count_revealed_nonprofession(person: Dictionary) -> int:
	var count := 0
	for category in person.get("revealed", []):
		if str(category) != "Профессия": count += 1
	return count

func _next_discussion_turn() -> void:
	if discussion_turn < discussion_queue.size():
		var speaker := discussion_queue[discussion_turn]
		var speaker_person := _find_person(speaker)
		if not speaker_person.is_empty() and bool(speaker_person.get("alive", true)):
			var target_count := _required_reveals_this_round(speaker_person)
			var opened_count := _count_revealed_nonprofession(speaker_person)
			if opened_count < target_count:
				var eligible: Array[String] = []
				for category in CARD_CATEGORIES:
					if category != "Профессия" and not speaker_person.get("revealed", []).has(category): eligible.append(str(category))
				var needed := mini(target_count - opened_count, eligible.size())
				if needed > 0:
					if is_instance_valid(phase_timer): phase_timer.stop()
					pending_discussion_after_reveal = true
					discussion_turn += 1
					for reveal_index in range(needed):
						var chosen_category := str(_pick(eligible))
						eligible.erase(chosen_category)
						var revealed: Array = speaker_person.get("revealed", [])
						revealed.append(chosen_category)
						speaker_person["revealed"] = revealed
						game_log.append("%s не раскрыл достаточно характеристик вовремя: автоматически открыта «%s»" % [speaker, chosen_category])
						reveal_overlay_queue.append({"type":"character", "name":speaker, "category":chosen_category, "value":str(speaker_person.get(_category_key(chosen_category), "—"))})
					for i in range(game_players.size()):
						if str(game_players[i].get("name", "")) == speaker:
							game_players[i] = speaker_person
							break
					discussion_revealed_this_turn.append(speaker)
					_show_gameplay()
					_display_next_reveal_overlay()
					return
		var statement := ""
		if speaker == player_name:
			statement = "%s: объясни, чем твоя профессия поможет пережить угрозу." % speaker
		else:
			var person := _find_person(speaker)
			if lobby_mutes.has(speaker):
				statement = "%s: (сообщения заглушены хостом)." % speaker
			else:
				statement = "%s: «Моя профессия пригодится для поддержания жизни в бункере»." % speaker
			if not person.is_empty():
				statement = "%s: «Я могу помочь группе благодаря профессии: %s»." % [speaker, str(person.get("profession", "неизвестно"))]
		discussion_statements.append(statement)
		game_log.append("Выступил участник: " + speaker + ".")
		discussion_turn += 1
		if discussion_turn >= discussion_queue.size():
			_begin_vote_prep()
		else:
			phase_seconds_left = SPEECH_TIME_SECONDS + int(discussion_bonus_seconds.get(discussion_queue[discussion_turn], 0))
			if is_instance_valid(phase_timer):
				phase_timer.start()
	_show_gameplay()

func _skip_own_discussion_turn() -> void:
	if network_client_active:
		_send_network_action({"action":"skip_turn"})
		return
	if game_phase != "discussion" or discussion_turn >= discussion_queue.size():
		return
	if discussion_queue[discussion_turn] != player_name:
		return
	game_log.append("%s пропустил своё время обсуждения." % player_name)
	var person := _find_person(player_name)
	var chosen := ""
	if not person.is_empty():
		var options: Array[String] = []
		for category in CARD_CATEGORIES:
			if category != "Профессия" and not person.get("revealed", []).has(category):
				options.append(str(category))
		if not options.is_empty():
			chosen = str(_pick(options))
			person["revealed"].append(chosen)
			for i in range(game_players.size()):
				if str(game_players[i].get("name", "")) == player_name:
					game_players[i] = person
					break
			discussion_revealed_this_turn.append(player_name)
	discussion_turn += 1
	if is_instance_valid(phase_timer):
		phase_timer.stop()
	if chosen != "":
		pending_discussion_after_reveal = true
		_show_gameplay()
		_show_character_reveal_splash(player_name, chosen, str(person.get(_category_key(chosen), "—")))
		return
	if discussion_turn >= discussion_queue.size():
		_begin_vote_prep()
		return
	phase_seconds_left = SPEECH_TIME_SECONDS + int(discussion_bonus_seconds.get(discussion_queue[discussion_turn], 0))
	if is_instance_valid(phase_timer):
		phase_timer.start()
	_show_gameplay()

func _toggle_game_pause() -> void:
	game_paused = not game_paused
	if game_paused:
		paused_timer_was_running = is_instance_valid(phase_timer) and not phase_timer.is_stopped()
		if is_instance_valid(phase_timer):
			phase_timer.stop()
		if is_instance_valid(active_reveal_overlay):
			for child in active_reveal_overlay.get_children():
				if child is Timer:
					child.paused = true
		game_log.append("Хост поставил игру на паузу.")
	else:
		if is_instance_valid(active_reveal_overlay):
			for child in active_reveal_overlay.get_children():
				if child is Timer:
					child.paused = false
		if paused_timer_was_running and is_instance_valid(phase_timer):
			phase_timer.start()
		game_log.append("Хост продолжил игру.")
	if current_screen == "voting":
		_show_voting_screen()
	elif current_screen == "game":
		_show_gameplay()
	if is_instance_valid(host_popup):
		_open_host_popup()

func _host_add_time(person_name: String, seconds: int = 30) -> void:
	if game_phase == "discussion" and discussion_turn < discussion_queue.size() and discussion_queue[discussion_turn] == person_name:
		phase_seconds_left += seconds
	else:
		discussion_bonus_seconds[person_name] = int(discussion_bonus_seconds.get(person_name, 0)) + seconds
	game_log.append("Хост добавил %d секунд участнику %s." % [seconds, person_name])
	_show_gameplay()
	_open_host_popup()

func _host_hide_character(person_name: String, category: String) -> void:
	for i in range(game_players.size()):
		var person: Dictionary = game_players[i]
		if str(person.get("name", "")) != person_name:
			continue
		var opened: Array = person.get("revealed", [])
		opened.erase(category)
		person["revealed"] = opened
		game_players[i] = person
		if bool(person.get("is_human", false)):
			human_revealed_categories.erase(category)
	game_log.append("Хост скрыл характеристику «%s» у участника %s." % [category, person_name])
	_show_gameplay()
	_open_host_popup()

func _host_reveal_character(person_name: String, category: String) -> void:
	for i in range(game_players.size()):
		var person: Dictionary = game_players[i]
		if str(person.get("name", "")) != person_name:
			continue
		var opened: Array = person.get("revealed", [])
		if not opened.has(category):
			opened.append(category)
		person["revealed"] = opened
		game_players[i] = person
		if bool(person.get("is_human", false)) and not human_revealed_categories.has(category):
			human_revealed_categories.append(category)
	game_log.append("Хост принудительно раскрыл характеристику «%s» участника %s." % [category, person_name])
	_show_gameplay()
	_open_host_popup()

func _host_set_character_value(person_name: String, category: String, new_value: String) -> void:
	var key := _category_key(category)
	if key.is_empty() or new_value.strip_edges().is_empty():
		return
	for i in range(game_players.size()):
		var person: Dictionary = game_players[i]
		if str(person.get("name", "")) == person_name:
			person[key] = new_value.strip_edges()
			person["score"] = _survival_score(person)
			game_players[i] = person
			break
	game_log.append("Хост вручную изменил характеристику «%s» участника %s." % [category, person_name])
	_show_gameplay()
	_open_host_popup()

func _host_randomize_character(person_name: String, category: String) -> void:
	var key := _category_key(category)
	var options := _values_for_category(category)
	if key.is_empty() or options.is_empty():
		return
	for i in range(game_players.size()):
		var person: Dictionary = game_players[i]
		if str(person.get("name", "")) == person_name:
			person[key] = str(_pick(options))
			person["score"] = _survival_score(person)
			game_players[i] = person
			break
	game_log.append("Хост изменил характеристику «%s» участника %s." % [category, person_name])
	_show_gameplay()
	_open_host_popup()

func _values_for_category(category: String) -> Array:
	match category:
		"Профессия": return PROFESSIONS
		"Биология": return BIOLOGIES
		"Здоровье": return HEALTHS
		"Хобби": return HOBBIES
		"Багаж": return BAGGAGE
		"Факт", "Факты": return FACTS
		"Характер": return TRAITS
		"Секрет": return SECRETS
		"Скрытый предмет": return ["Аварийный радиомаяк", "Запас антибиотиков", "Набор инструментов", "Фильтр для воды", "Карта технических тоннелей", "Ничего ценного"]
		"Тайная цель": return ["Защитить медика", "Сохранить реактор", "Найти сигнал с поверхности", "Не допустить исключения друга", "Получить контроль над запасами"]
		"Скрытая проблема": return ["Скрывает хроническую болезнь", "Панически боится замкнутых пространств", "Имеет зависимость", "Не спал несколько суток", "Скрытых проблем не обнаружено"]
		"Особое условие": return SPECIAL_CONDITIONS
	return []

func _begin_extra_reveals() -> void:
	game_phase = "reveal"
	phase_seconds_left = 8
	if phase_timer != null:
		if is_instance_valid(phase_timer):
			phase_timer.start()
	revealed_categories.clear()
