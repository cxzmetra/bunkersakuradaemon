func _previous_player_presentation() -> void:
	if network_client_active: return
	presentation_index = maxi(0, presentation_index - 1)
	phase_seconds_left = 3
	_show_player_presentation()

func _advance_player_presentation() -> void:
	if network_client_active: return
	presentation_index += 1
	if presentation_index >= game_players.size():
		_finish_player_presentation()
		return
	phase_seconds_left = 3
	if is_instance_valid(phase_timer):
		phase_timer.start()
	_show_player_presentation()

func _finish_player_presentation() -> void:
	if network_client_active: return
	if is_instance_valid(phase_timer):
		phase_timer.stop()
	game_phase = "private_review"
	phase_seconds_left = PRIVATE_REVIEW_SECONDS
	current_screen = "game"
	game_log.append("Личное ознакомление с характеристиками: 30 секунд.")
	if is_instance_valid(phase_timer):
		phase_timer.start()
	_show_gameplay()

func _show_character_reveal_splash(person_name: String, category: String, value: String) -> void:
	reveal_overlay_queue.append({"type": "character", "name": person_name, "category": category, "value": value})
	_display_next_reveal_overlay()

func _display_next_reveal_overlay() -> void:
	if is_instance_valid(active_reveal_overlay) or reveal_overlay_queue.is_empty():
		return
	var item: Dictionary = reveal_overlay_queue.pop_front()
	if str(item.get("type", "character")) == "roster":
		_render_category_reveal_roster(str(item.get("category", "ХАРАКТЕРИСТИКА")))
	else:
		_render_character_reveal_splash(str(item.get("name", "УЧАСТНИК")), str(item.get("category", "ХАРАКТЕРИСТИКА")), str(item.get("value", "—")))

