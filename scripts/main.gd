func _random_value_for_category(category: String) -> String:
	match category:
		"Профессия": return _pick_mode_value("profession", PROFESSIONS)
		"Биология": return _pick_mode_value("biology", BIOLOGIES + EXTRA_BIOLOGIES)
		"Хобби": return _pick_mode_value("hobby", HOBBIES)
		"Факты", "Факт": return _pick_mode_value("facts", FACTS + EXTRA_FACTS)
		"Особое условие": return _pick_mode_value("special_condition", SPECIAL_CONDITIONS)
		"Здоровье": return _pick_mode_value("health", HEALTHS + EXTRA_HEALTHS)
		"Багаж": return _pick_mode_value("baggage", BAGGAGE + EXTRA_BAGGAGE)
		"Характер": return _pick_mode_value("trait", TRAITS + EXTRA_TRAITS)
		"Секрет": return _pick_mode_value("secret", SECRETS + EXTRA_SECRETS)
		"Скрытый предмет": return _pick(["Аварийный радиомаяк", "Запас антибиотиков", "Набор инструментов", "Фильтр для воды", "Карта технических тоннелей", "Ничего ценного"])
		"Тайная цель": return _pick(["Защитить медика", "Сохранить реактор", "Найти сигнал с поверхности", "Не допустить исключения друга", "Получить контроль над запасами"])
		"Скрытая проблема": return _pick(["Скрывает хроническую болезнь", "Панически боится замкнутых пространств", "Имеет зависимость", "Не спал несколько суток", "Скрытых проблем не обнаружено"])
	return "Неизвестно"

func _draw_two_special_abilities() -> Array[String]:
	var pool: Array = SPECIAL_ABILITIES.duplicate()
	pool.shuffle()
	var result: Array[String] = []
	for i in range(mini(2, pool.size())): result.append(str(pool[i]))
	return result

func _survival_score(person: Dictionary) -> int:
	var score := 0
	var prof := str(person.profession)
	var cat_name := str(current_game_catastrophe.get("name", selected_catastrophe))
	if cat_name == "Смертельная пандемия":
		if prof in ["Врач", "Биолог", "Военный медик"]: score += 5
		if str(person.health) == "Иммунитет к известному вирусу": score += 4
		if str(person.baggage) == "Аптечка": score += 2
	elif cat_name == "Глобальный потоп":
		if prof in ["Механик", "Инженер", "Электрик", "Спасатель"]: score += 4
		if str(person.hobby) in ["Рыбалка", "Ремонт техники", "Ориентирование"]: score += 2
		if str(person.baggage) == "Фильтр для воды": score += 2
	elif cat_name == "Ядерная зима":
		if prof in ["Инженер", "Электрик", "Фермер", "Механик"]: score += 3
		if str(person.health) == "Повышенная устойчивость к холоду": score += 4
		if str(person.baggage) in ["Запас консервов", "Семена овощей"]: score += 2
	elif cat_name == "Восстание ИИ":
		if prof in ["Программист", "Электрик", "Инженер"]: score += 5
		if str(person.hobby) in ["Ремонт техники", "Радиосвязь"]: score += 2
	elif cat_name == "Падение метеорита":
		if prof in ["Спасатель", "Врач", "Геолог", "Механик"]: score += 4
		if str(person.baggage) in ["Аптечка", "Набор инструментов"]: score += 2
	else:
		if prof in ["Врач", "Инженер", "Механик", "Фермер"]: score += 3
		if str(person.baggage) in ["Аптечка", "Запас консервов", "Фильтр для воды"]: score += 2
	if str(person.trait) in ["Командный игрок", "Спокойный лидер", "Наблюдательный"]: score += 1
	if str(person.trait) in ["Эгоист", "Импульсивный", "Паникёр"]: score -= 1
	return score

func _ensure_player_scenario_relevance() -> void:
	# The human player receives a small chance of a useful profile so the first run feels fair.
	if game_players.is_empty(): return
	var human: Dictionary = game_players[0]
	if int(human.score) < 2:
		human.profession = "Инженер" if selected_catastrophe != "Смертельная пандемия" else "Врач"
		human.score = _survival_score(human)
		game_players[0] = human

