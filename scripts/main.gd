	_label(stack, "Игроков в живых: %d  •  Мест в бункере: %d" % [_alive_count(), bunker_capacity], 11, MUTED)
	match game_phase:
		"profession":
			_label(stack, "Профессии раскрываются автоматически — один участник каждые 10 секунд.", 12, CYAN)
		"discussion":
			if discussion_turn < discussion_queue.size():
				_label(stack, "ХОД: %s (%d/%d)" % [discussion_queue[discussion_turn], discussion_turn + 1, discussion_queue.size()], 14, CYAN)
				_label(stack, "Осталось времени: %02d:%02d" % [floori(float(phase_seconds_left) / 60.0), phase_seconds_left % 60], 12, CREAM)
				if discussion_queue[discussion_turn] == player_name:
					_button(stack, "ПРОПУСТИТЬ МОЙ ХОД", _skip_own_discussion_turn, false)
				var speech := LineEdit.new()
				speech.placeholder_text = "Аргументы участника (для твоего хода)"
				stack.add_child(speech)
				_button(stack, "ЗАВЕРШИТЬ ВЫСТУПЛЕНИЕ", func():
					if discussion_queue[discussion_turn] == player_name and not speech.text.strip_edges().is_empty():
						discussion_statements.append(player_name + ": «" + speech.text.strip_edges() + "»")
					_next_discussion_turn()
					_open_host_popup()
				, true)
			else:
				_label(stack, "Обсуждение завершено. Переход дальше произойдёт автоматически.", 12, MUTED)
		"reveal":
			_label(stack, "Карты раскрываются автоматически по таймеру.", 12, CREAM)
			_button(stack, "РАСКРЫТЬ СЛЕДУЮЩУЮ КАРТУ СЕЙЧАС", _reveal_extra_category, false)
			_button(stack, "ПЕРЕЙТИ К ГОЛОСОВАНИЮ", _begin_vote, true)
		"vote_prep":
			_label(stack, "Идёт 10-секундная подготовка. После неё голосование начнётся автоматически.", 12, CYAN)
			_button(stack, "НАЧАТЬ ГОЛОСОВАНИЕ СЕЙЧАС", _begin_vote, true)
		"vote":
			_label(stack, "Выбери цель голосования на основном экране или запусти экран голосования.", 12, CREAM)
			_button(stack, "ОТКРЫТЬ ГОЛОСОВАНИЕ", _show_voting_screen, true)
		"result":
			_button(stack, "СЛЕДУЮЩИЙ РАУНД", _next_round, true)
	var admin_divider := HSeparator.new()
	stack.add_child(admin_divider)
	_label(stack, "АДМИНИСТРИРОВАНИЕ УЧАСТНИКОВ", 14, CYAN)
	var target_select := OptionButton.new()
	var target_names: Array[String] = []
	for person in game_players:
		target_names.append(str(person.get("name", "Участник")))
		target_select.add_item(str(person.get("name", "Участник")))
	stack.add_child(target_select)
	var category_select := OptionButton.new()
	for category in CARD_CATEGORIES:
		category_select.add_item(str(category))
	stack.add_child(category_select)
	var custom_value := LineEdit.new()
	custom_value.placeholder_text = "Новое значение характеристики (необязательно)"
	custom_value.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	stack.add_child(custom_value)	
	var admin_row := HBoxContainer.new()
	admin_row.add_theme_constant_override("separation", 6)
	stack.add_child(admin_row)
	_button(admin_row, "+30 СЕКУНД", func():
		if target_select.item_count > 0:
			_host_add_time(target_names[target_select.selected], 30)
	, true)
	_button(admin_row, "СКРЫТЬ КАРТУ", func():
		if target_select.item_count > 0 and category_select.item_count > 0:
			_host_hide_character(target_names[target_select.selected], category_select.get_item_text(category_select.selected))
	, false)
	_button(admin_row, "РАСКРЫТЬ КАРТУ", func():
		if target_select.item_count > 0 and category_select.item_count > 0:
			_host_reveal_character(target_names[target_select.selected], category_select.get_item_text(category_select.selected))
	, false)
	_button(admin_row, "СЛУЧАЙНОЕ ЗНАЧЕНИЕ", func():
		if target_select.item_count > 0 and category_select.item_count > 0:
			_host_randomize_character(target_names[target_select.selected], category_select.get_item_text(category_select.selected))
	, false)
	_button(admin_row, "ЗАДАТЬ ЗНАЧЕНИЕ", func():
		if target_select.item_count > 0 and category_select.item_count > 0 and not custom_value.text.strip_edges().is_empty():
			_host_set_character_value(target_names[target_select.selected], category_select.get_item_text(category_select.selected), custom_value.text.strip_edges())
	, false)
	_button(stack, "⏸ ПОСТАВИТЬ ИГРУ НА ПАУЗУ" if not game_paused else "▶ ВОЗОБНОВИТЬ ИГРУ", _toggle_game_pause, false)
	_button(stack, "ЗАКРЫТЬ ПАНЕЛЬ", func(): host_popup.hide(), false)
	host_popup.confirmed.connect(func():
		if is_instance_valid(host_popup):
			host_popup.queue_free()
	)
	host_popup.popup_centered()


func _phase_title() -> String:
	match game_phase:
		"private_review": return "ЛИЧНОЕ ОЗНАКОМЛЕНИЕ С ДОСЬЕ"
		"profession": return "РАСКРЫТИЕ ПРОФЕССИЙ"
		"discussion": return "ОБСУЖДЕНИЕ"
		"reveal": return "ДОПОЛНИТЕЛЬНЫЕ ХАРАКТЕРИСТИКИ"
		"vote_prep": return "ПОДГОТОВКА К ГОЛОСОВАНИЮ"
		"vote": return "ГОЛОСОВАНИЕ"
		"result": return "РЕЗУЛЬТАТ РАУНДА"
		"finished": return "ПАРТИЯ ЗАВЕРШЕНА"
	return "ПОДГОТОВКА"

func _phase_hint() -> String:
	match game_phase:
		"private_review": return "ЛИЧНОЕ ДОСЬЕ • у тебя есть 30 секунд, чтобы спокойно изучить свои характеристики. Они пока не раскрываются другим игрокам. Затем профессии участников появятся по очереди с интервалом 10 секунд."
		"profession": return "РАСКРЫТИЕ ПРОФЕССИЙ • профессии показываются по одной с интервалом 10 секунд. Сначала видна только профессия участника, чей ход сейчас."
		"discussion":
			if discussion_turn < discussion_queue.size():
				return "ОБСУЖДЕНИЕ • СЕЙЧАС ХОД: %s (%d из %d). В свой ход выбери одну характеристику для раскрытия." % [discussion_queue[discussion_turn], discussion_turn + 1, discussion_queue.size()]
			return "ОБСУЖДЕНИЕ • оценивайте раскрытые характеристики и полезность участников."
		"reveal": return "РАСКРЫТИЕ ХАРАКТЕРИСТИК • участники выбирают, что раскрыть."
		"vote_prep": return "ПОДГОТОВКА К ГОЛОСОВАНИЮ • 10 секунд на просмотр характеристик и выбор кандидата."
		"vote": return "ГОЛОСОВАНИЕ • выбери участника для исключения. Когда таймер закончится, игра подсчитает голоса."
		"result": return "ИТОГИ РАУНДА • применяются последствия решения и проверяется состояние бункера."
		"finished": return "ПАРТИЯ ЗАВЕРШЕНА • изучи результаты и статистику выживания."
	return "ПОДГОТОВКА • система готовит следующий этап."


func _open_chat_popup() -> void:
	utility_popup = AcceptDialog.new()
	utility_popup.title = "ЧАТ КОМНАТЫ"
	utility_popup.size = Vector2i(620, 460)
	add_child(utility_popup)
	utility_popup_content = VBoxContainer.new()
	utility_popup_content.add_theme_constant_override("separation", 7)
	utility_popup.add_child(utility_popup_content)
	_render_chat_popup()
	utility_popup.confirmed.connect(func(): utility_popup.queue_free())
	utility_popup.popup_centered()

func _render_chat_popup() -> void:
	if not is_instance_valid(utility_popup_content):
		return
	for child in utility_popup_content.get_children():
		child.queue_free()
	var scroll := ScrollContainer.new()
	scroll.custom_minimum_size.y = 270
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	utility_popup_content.add_child(scroll)
	var messages := VBoxContainer.new()
	messages.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.add_child(messages)
	if room_chat_messages.is_empty():
		_label(messages, "Сообщений пока нет — начни разговор.", 12, MUTED)
	else:
		for message in room_chat_messages:
			_label(messages, message, 12, CREAM)
	var row := HBoxContainer.new()
	utility_popup_content.add_child(row)
	var entry := LineEdit.new()
	entry.placeholder_text = "Сообщение..."
	entry.max_length = 500
	entry.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(entry)
	_button(row, "ОТПРАВИТЬ", func():
		var clean := entry.text.strip_edges()
		if clean.is_empty():
			return
		room_chat_messages.append("%s: %s" % [player_name, clean.substr(0, 500)])
		if room_chat_messages.size() > 100:
			room_chat_messages.pop_front()
		_render_chat_popup()
	, true)

func _show_chat_screen() -> void:
	current_screen = "chat"
	_clear_screen()
	_background(self, 0.82)
	var page := _page()
	_header(page, "ЧАТ КОМНАТЫ", "ОБЩЕНИЕ ИГРОКОВ  •  БЕЗ СИСТЕМНЫХ СОБЫТИЙ")
	var chat_panel := _panel(page, Color("#101213"), ORANGE)
	var message_list := VBoxContainer.new()
	message_list.add_theme_constant_override("separation", 8)
	chat_panel.add_child(message_list)
	var scroll := ScrollContainer.new()
	scroll.custom_minimum_size.y = 300
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	chat_panel.add_child(scroll)
	var messages := VBoxContainer.new()
	messages.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	messages.add_theme_constant_override("separation", 5)
	scroll.add_child(messages)
	if room_chat_messages.is_empty():
		_label(messages, "Пока сообщений нет. Начни разговор.", 13, MUTED)
	else:
		for message in room_chat_messages:
			var msg_panel := _panel(messages, Color("#191b1c"), BORDER)
			_label(msg_panel, message, 12, CREAM)
	var composer := HBoxContainer.new()
	composer.add_theme_constant_override("separation", 8)
	page.add_child(composer)
	var entry := LineEdit.new()
	entry.placeholder_text = "Напиши сообщение..."
	entry.max_length = 500
	entry.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	composer.add_child(entry)
	var send_button := _button(composer, "ОТПРАВИТЬ", func(): _send_room_chat_message(entry.text), true)
	send_button.custom_minimum_size.x = 130
	entry.text_submitted.connect(func(text: String): _send_room_chat_message(text))
	_button(page, "← НАЗАД В ПАРТИЮ", _show_gameplay, false)

func _send_room_chat_message(message_text: String) -> void:
	var clean_text := message_text.strip_edges()
	if clean_text.is_empty():
		return
	if clean_text.length() > 500:
		clean_text = clean_text.substr(0, 500)
	room_chat_messages.append("%s: %s" % [player_name, clean_text])
	if room_chat_messages.size() > 100:
		room_chat_messages.pop_front()
	_show_chat_screen()

func _seed_ai_relationships() -> void:
	# Seed visible, lightweight respect/disrespect links for the offline NPC cast.
	for source in game_players:
		var source_name := str(source.get("name", ""))
		if bool(source.get("is_human", false)): continue
		for target_person in game_players:
			var target_name := str(target_person.get("name", ""))
			if source_name == target_name or bool(target_person.get("is_human", false)): continue
			var roll := randi_range(0, 4)
			if roll == 0: relationship_scores[_relationship_key(source_name, target_name)] = -1
			elif roll == 1: relationship_scores[_relationship_key(source_name, target_name)] = 1

func _relationship_key(from_name: String, to_name: String) -> String:
	return from_name + "->" + to_name

func _add_relationship_panel(parent: Control) -> void:
	var panel := _panel(parent, Color("#111718"), CYAN)
	var stack := VBoxContainer.new()
	stack.add_theme_constant_override("separation", 6)
	panel.add_child(stack)
	_label(stack, "РЕСПЕКТЫ И ДИЗРЕСПЕКТЫ", 14, CYAN)
	_label(stack, "Отметь своё отношение к участникам. Это личная отметка для понимания отношений, а не скрытая характеристика и не автоматический голос.", 11, MUTED)
	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 8)
	stack.add_child(row)
	var target := OptionButton.new()
	var names: Array[String] = []
	for person in game_players:
		var nm := str(person.get("name", ""))
		if nm == player_name: continue
		names.append(nm)
		target.add_item(nm)
	row.add_child(target)
	var current_status := _label(row, "ОТНОШЕНИЕ: —", 11, CREAM)
	if target.item_count > 0:
		current_status.text = _relationship_label(names[0])
		target.item_selected.connect(func(index: int): current_status.text = _relationship_label(names[index]))
		_button(row, "👍 РЕСПЕКТ", func(): _set_relationship(names[target.selected], 1), true)
		_button(row, "👎 ДИЗРЕСПЕКТ", func(): _set_relationship(names[target.selected], -1), false)
	var summary: Array[String] = []
	for nm in names:
		var score := int(relationship_scores.get(_relationship_key(player_name, nm), 0))
		if score != 0: summary.append(player_name + (" 👍 " if score > 0 else " 👎 ") + nm)
	for source in game_players:
		var source_name := str(source.get("name", ""))
		if bool(source.get("is_human", false)): continue
		for target_person in game_players:
			var target_name := str(target_person.get("name", ""))
			if source_name == target_name: continue
			var score := int(relationship_scores.get(_relationship_key(source_name, target_name), 0))
			if score != 0: summary.append(source_name + (" 👍 " if score > 0 else " 👎 ") + target_name)
	var summary_label := _label(stack, "ОТНОШЕНИЯ: " + ("  •  ".join(PackedStringArray(summary)) if not summary.is_empty() else "пока нет выраженных отметок"), 11, GREEN)
	summary_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART

func _relationship_label(target_name: String) -> String:
	var score := int(relationship_scores.get(_relationship_key(player_name, target_name), 0))
	return "ОТНОШЕНИЕ К %s: %s" % [target_name, "РЕСПЕКТ 👍" if score > 0 else ("ДИЗРЕСПЕКТ 👎" if score < 0 else "НЕ ОТМЕЧЕНО")]

func _set_relationship(target_name: String, value: int) -> void:
	if target_name.is_empty(): return
	var key := _relationship_key(player_name, target_name)
	relationship_scores[key] = 0 if int(relationship_scores.get(key, 0)) == value else value
	game_log.append(("Респект" if value > 0 else "Дизреспект") + ": " + player_name + " → " + target_name)
	_show_gameplay()

func _add_character_table(parent: Control) -> void:
	# No nested ScrollContainer: the whole page scrolls naturally, keeping the roster in one continuous view.
	var table_panel := _panel(parent, Color("#101213"), BORDER)
	table_panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var table := GridContainer.new()
	table.name = "CharacterTableGrid"
	table.columns = CARD_CATEGORIES.size() + 2
	table.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	table.add_theme_constant_override("h_separation", 3)
	table.add_theme_constant_override("v_separation", 3)
	table_panel.add_child(table)
	var headers: Array[String] = ["№", "УЧАСТНИК"]
	headers.append_array(CARD_CATEGORIES)
	for head in headers:
		var cell := _label(table, head.to_upper(), 10, ORANGE)
		var cell_width := 38 if head == "№" else (142 if head == "УЧАСТНИК" else 132)
		cell.custom_minimum_size = Vector2(cell_width, 48)
		cell.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		cell.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		cell.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		cell.clip_text = false
		cell.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		cell.add_theme_stylebox_override("normal", _style(Color("#20170f"), ORANGE_DARK))
	for i in range(game_players.size()):
		var person: Dictionary = game_players[i]
		var is_alive := bool(person.get("alive", true))
		var idx := _label(table, "%02d" % (i + 1), 11, MUTED)
		idx.custom_minimum_size = Vector2(38, 58)
		idx.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		idx.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		var name_text := str(person.get("name", "—"))
		if bool(person.get("is_human", false)):
			name_text = "★ " + name_text
		if not is_alive:
			name_text += "\nИСКЛЮЧЁН"
		var nm := _label(table, name_text, 11, CREAM if is_alive else RED)
		nm.custom_minimum_size = Vector2(142, 58)
		nm.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		nm.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		nm.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		for category in CARD_CATEGORIES:
			var key := _category_key(str(category))
			var category_is_visible := bool(person.get("is_human", false)) and human_revealed_categories.has(category)
			if not bool(person.get("is_human", false)):
				category_is_visible = person.get("revealed", []).has(category)
			var value := str(person.get(key, "—")) if category_is_visible else "???"
			var cell := _label(table, value, 10, GREEN if category_is_visible else MUTED)
			cell.custom_minimum_size = Vector2(132, 58)
			cell.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
			cell.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			cell.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			cell.clip_text = false
			cell.tooltip_text = category + ": " + (value if category_is_visible else "ещё не раскрыто")
			cell.add_theme_stylebox_override("normal", _style(Color("#111516") if is_alive else Color("#1d1011"), BORDER))

func _add_person_card(parent: Control, person: Dictionary) -> void:
	var is_alive := bool(person.alive)
	var is_human := bool(person.is_human)
	var border_color := ORANGE if is_human else (GREEN if is_alive else RED)
	var panel := _panel(parent, Color("#151718") if is_alive else Color("#201112"), border_color)
	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 7)
	panel.add_child(row)
	var avatar := _panel(row, Color("#22170f") if is_human else Color("#1c1d1e"), border_color)
	avatar.custom_minimum_size = Vector2(42, 42)
	avatar.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	var avatar_label := _label(avatar, "Я" if is_human else str(person.name).left(1), 17, border_color)
	avatar_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	avatar_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	var info := VBoxContainer.new()
	info.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	info.add_child(_label(info, str(person.name) + ("  •  ВЫ" if is_human else "") + ("" if is_alive else "  •  ИСКЛЮЧЁН"), 12, CREAM if is_alive else RED))
	var lines: Array[String] = []
	var visible_categories: Array[String] = human_revealed_categories if is_human else revealed_categories
	for category in visible_categories:
		lines.append(category + ": " + str(person.get(_category_key(category), "—")))
	if lines.is_empty():
		lines.append("Карточки закрыты")
	var details := _label(info, "  |  ".join(PackedStringArray(lines)), 10, MUTED)
	details.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	row.add_child(info)
	var score := _label(row, "%+d" % int(person.score), 13, GREEN if int(person.score) >= 2 else (RED if int(person.score) < 0 else ORANGE))
	score.custom_minimum_size.x = 28
	score.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT

func _add_human_lock_card(parent: Control, category: String) -> void:
	var local_person := _find_person(player_name)
	var local_revealed: Array = local_person.get("revealed", []) if not local_person.is_empty() else []
	var is_open := local_revealed.has(category) or human_revealed_categories.has(category)
	var value_text := str(local_person.get(_category_key(category), "—")) if not local_person.is_empty() else "—"
	var card_text := category.to_upper() + "\n" + value_text + ("  •  РАСКРЫТА" if is_open else "  •  НАЖМИ, ЧТОБЫ РАСКРЫТЬ")
	var card := _button(parent, card_text, func(): _toggle_human_card(category), is_open)
	card.custom_minimum_size = Vector2(0, 66)
	card.add_theme_font_size_override("font_size", 11)
	card.add_theme_color_override("font_color", GREEN if is_open else RED)
	card.add_theme_color_override("font_hover_color", GREEN if is_open else ORANGE)

func _toggle_human_card(category: String) -> void:
	if network_client_active:
		if game_phase == "discussion" and discussion_turn < discussion_queue.size() and discussion_queue[discussion_turn] == player_name:
			_send_network_action({"action":"reveal", "category":category})
			return
	if game_phase == "private_review" or game_phase == "profession":
		return
	if human_revealed_categories.has(category):
		return
	if game_phase != "discussion":
		return
	if discussion_turn >= discussion_queue.size() or discussion_queue[discussion_turn] != player_name:
		return
	if category == "Профессия":
		return
	if game_players.is_empty():
		return
	var person: Dictionary = game_players[0]
	var already_revealed: Array = person.get("revealed", [])
	if already_revealed.has(category):
		return
	already_revealed.append(category)
	person["revealed"] = already_revealed
	game_players[0] = person
	human_revealed_categories.append(category)
	var opened_now := _count_revealed_nonprofession(person)
	discussion_reveal_counts[player_name] = opened_now
	if not discussion_revealed_this_turn.has(player_name):
		discussion_revealed_this_turn.append(player_name)
	game_log.append("%s выбрал и раскрыл характеристику: %s." % [player_name, category])
	var revealed_value := str(person.get(_category_key(category), "—"))
	network_last_reveal = {"id":"%d|%s|%s|%d" % [game_round, player_name, category, Time.get_ticks_msec()], "name":player_name, "category":category, "value":revealed_value}
	if is_instance_valid(phase_timer):
		phase_timer.stop()
	pending_resume_discussion_turn = true
	_show_gameplay()
	_show_character_reveal_splash(player_name, category, revealed_value)

