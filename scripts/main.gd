func _process(delta: float) -> void:
	_poll_network()
	_poll_room_discovery()
	if network_connected and network_is_host and game_session_active:
		network_snapshot_accumulator += delta
		if network_snapshot_accumulator >= 0.5:
			network_snapshot_accumulator = 0.0
			_broadcast_network_game_state(false)
	# Persistent local playtime; retain fractional frames instead of dropping them.
	playtime_fractional_seconds += delta
	playtime_autosave_accumulator += delta
	if playtime_fractional_seconds >= 1.0:
		var whole_seconds := int(playtime_fractional_seconds)
		total_play_seconds += whole_seconds
		playtime_fractional_seconds -= float(whole_seconds)
	if playtime_autosave_accumulator >= 15.0:
		playtime_autosave_accumulator = 0.0
		_save_user_settings()

func _open_network_chat() -> void:
	var dialog := AcceptDialog.new()
	dialog.title = "СЕТЕВОЙ ЧАТ"
	dialog.dialog_text = "\n".join(PackedStringArray(room_chat_messages.slice(maxi(0, room_chat_messages.size() - 12), room_chat_messages.size())))
	add_child(dialog)
	var input := LineEdit.new()
	input.placeholder_text = "Сообщение участникам комнаты"
	input.custom_minimum_size.y = 38
	dialog.add_child(input)
	dialog.add_button("ОТПРАВИТЬ", false, "send_message")
	dialog.custom_action.connect(func(action: String):
		if action == "send_message" and not input.text.strip_edges().is_empty():
			_send_network_message({"type":"chat", "text":input.text.strip_edges()})
			input.clear()
			dialog.dialog_text = "\n".join(PackedStringArray(room_chat_messages.slice(maxi(0, room_chat_messages.size() - 12), room_chat_messages.size())))
	)
	dialog.popup_centered(Vector2i(600, 460))

func _connect_to_free_server() -> void:
	if network_peer != null:
		network_peer.close()
	network_peer = WebSocketPeer.new()
	var error := network_peer.connect_to_url(network_server_url)
	if error != OK:
		network_status = "ОШИБКА ПОДКЛЮЧЕНИЯ: %s" % error_string(error)
		return
	network_connected = false
	network_status = "ПОДКЛЮЧЕНИЕ..."

func _disconnect_from_free_server() -> void:
	if discovery_peer != null:
		discovery_peer.close()
		discovery_peer = null
	if network_peer != null:
		network_peer.close()
	network_connected = false
	network_client_active = false
	network_is_host = false
	network_player_id = ""
	network_room_players.clear()
	network_status = "ОФЛАЙН"

func _send_network_message(message: Dictionary) -> void:
	if network_peer != null and network_peer.get_ready_state() == WebSocketPeer.STATE_OPEN:
		network_peer.send_text(JSON.stringify(message))

func _poll_network() -> void:
	if network_peer == null:
		return
	network_peer.poll()
	var state := network_peer.get_ready_state()
	if state == WebSocketPeer.STATE_OPEN:
		if not network_connected:
			network_connected = true
			network_status = "СОЕДИНЕНО"
			_send_network_message({"type":"join", "room":network_room_code, "name":player_name, "host":network_is_host})
		while network_peer.get_available_packet_count() > 0:
			var packet := network_peer.get_packet().get_string_from_utf8()
			var parsed: Variant = JSON.parse_string(packet)
			if not (parsed is Dictionary):
				continue
			var message_type := str(parsed.get("type", ""))
			match message_type:
				"joined":
					network_player_id = str(parsed.get("id", ""))
					network_is_host = bool(parsed.get("host", network_is_host))
					network_room_code = str(parsed.get("room", network_room_code))
					lobby_code = network_room_code
					network_status = ("ХОСТ" if network_is_host else "ИГРОК") + " • КОМНАТА " + network_room_code
				"lobby_state":
					network_room_code = str(parsed.get("room", network_room_code))
					lobby_code = network_room_code
					network_room_players.clear()
					for player_data in parsed.get("players", []):
						if player_data is Dictionary:
							network_room_players.append(player_data.duplicate(true))
					network_status = "КОМНАТА %s • %s/%s" % [network_room_code, str(parsed.get("count", "?")), str(player_count)]
					if current_screen == "lobby" and not network_client_active and not game_session_active: call_deferred("_show_lobby")
				"chat":
					room_chat_messages.append(str(parsed.get("name", "Игрок")) + ": " + str(parsed.get("text", "")))
					if room_chat_messages.size() > 100:
						room_chat_messages.pop_front()
				"room_closed":
					network_status = "КОМНАТА ЗАКРЫТА: хост отключился"
					network_client_active = false
					network_connected = false
				"game_started":
					network_client_active = not network_is_host
					network_status = "ПАРТИЯ ЗАПУЩЕНА ХОСТОМ • СИНХРОНИЗАЦИЯ АКТИВНА"
				"game_state":
					if not network_is_host:
						_apply_network_game_state(parsed.get("state", {}))
				"timer_sync":
					if network_client_active:
						phase_seconds_left = int(parsed.get("seconds", phase_seconds_left))
						game_paused = bool(parsed.get("paused", game_paused))
						if is_instance_valid(network_timer_label):
							network_timer_label.text = ("⏸ ПАУЗА • " if game_paused else "ОСТАЛОСЬ ") + "%02d:%02d" % [floori(float(phase_seconds_left) / 60.0), phase_seconds_left % 60]
						if is_instance_valid(network_progress_bar):
							network_progress_bar.value = clampf(float(phase_seconds_left), 0.0, network_progress_bar.max_value)
				"game_action":
					if network_is_host:
						_handle_network_game_action(str(parsed.get("sender", "")), parsed.get("action", {}))
				"error":
					network_status = "СЕТЕВАЯ ОШИБКА: " + str(parsed.get("message", "неизвестно"))
	elif state == WebSocketPeer.STATE_CLOSED:
		network_connected = false
		network_status = "СОЕДИНЕНИЕ ЗАКРЫТО"

func _ensure_local_server_started() -> void:
	local_server_start_error = false
	if local_server_started:
		return
	# For local/LAN hosting, start the bundled relay automatically. Internet rooms
	# still need a publicly reachable relay endpoint; this does not expose a port by magic.
	if not (network_server_url.contains("127.0.0.1") or network_server_url.contains("localhost")):
		return
	if network_peer != null and network_peer.get_ready_state() != WebSocketPeer.STATE_CLOSED:
		return
	var server_dir := ProjectSettings.globalize_path("res://multiplayer_server")
	var node_check: Array = []
	var node_result := OS.execute("node", ["--version"], node_check, true)
	if node_result != 0:
		local_server_start_error = true
		network_status = "НУЖЕН NODE.JS LTS ДЛЯ АВТОЗАПУСКА ЛОКАЛЬНОГО СЕРВЕРА"
		return
	var ws_module := server_dir.path_join("node_modules/ws")
	if not DirAccess.dir_exists_absolute(ws_module):
		var install_output: Array = []
		var install_code := OS.execute("npm", ["--prefix", server_dir, "install", "--omit=dev"], install_output, true)
		if install_code != 0:
			local_server_start_error = true
			network_status = "НЕ УДАЛОСЬ УСТАНОВИТЬ СЕТЕВЫЕ ЗАВИСИМОСТИ; СМОТРИ ИНСТРУКЦИЮ"
			return
	var launch_output: Array = []
	OS.execute("node", [server_dir.path_join("server.js")], launch_output, false)
	local_server_started = true

func _poll_room_discovery() -> void:
	if discovery_peer == null:
		return
	discovery_peer.poll()
	var state := discovery_peer.get_ready_state()
	if state == WebSocketPeer.STATE_OPEN and not discovery_request_sent:
		discovery_request_sent = true
		discovery_peer.send_text(JSON.stringify({"type":"list_rooms"}))
	while discovery_peer != null and discovery_peer.get_ready_state() == WebSocketPeer.STATE_OPEN and discovery_peer.get_available_packet_count() > 0:
		var raw := discovery_peer.get_packet().get_string_from_utf8()
		var parsed: Variant = JSON.parse_string(raw)
		if parsed is Dictionary and str(parsed.get("type", "")) == "room_list":
			network_public_rooms.clear()
			for item in parsed.get("rooms", []):
				if item is Dictionary:
					network_public_rooms.append(item.duplicate(true))
			if current_screen == "lobby":
				call_deferred("_show_lobby")
			discovery_peer.close()
			discovery_peer = null
			return
	if state == WebSocketPeer.STATE_CLOSED:
		discovery_peer = null

func _refresh_public_rooms() -> void:
	if network_connected:
		network_status = "СНАЧАЛА ОТКЛЮЧИТЕСЬ ОТ ТЕКУЩЕЙ КОМНАТЫ, ЧТОБЫ ОБНОВИТЬ СПИСОК"
		_show_lobby()
		return
	if discovery_peer != null:
		discovery_peer.close()
	discovery_peer = WebSocketPeer.new()
	discovery_request_sent = false
	var err := discovery_peer.connect_to_url(network_server_url)
	if err != OK:
		network_status = "НЕ УДАЛОСЬ ОБНОВИТЬ КОМНАТЫ: %s" % error_string(err)
	else:
		network_status = "ПОИСК ОТКРЫТЫХ КОМНАТ..."
		_show_lobby()

func _start_free_network_room() -> void:
	_ensure_local_server_started()
	if local_server_start_error:
		_show_lobby()
		return
	if local_server_started:
		await get_tree().create_timer(0.8).timeout
	network_room_code = "B-%04d" % randi_range(1000, 9999)
	network_is_host = true
	network_client_active = false
	_connect_to_free_server()

func _join_free_network_room() -> void:
	network_is_host = false
	network_client_active = false
	if network_room_code.strip_edges().is_empty():
		network_room_code = lobby_code
	_connect_to_free_server()

func _network_game_state() -> Dictionary:
	return {
		"player_name": player_name, "player_count": player_count, "desired_survivors": desired_survivors,
		"selected_style_mode": selected_style_mode, "selected_catastrophe": selected_catastrophe, "selected_map": selected_map,
		"current_screen": current_screen, "game_session_active": game_session_active, "game_finished": game_finished,
		"game_round": game_round, "game_phase": game_phase, "phase_seconds_left": phase_seconds_left, "game_paused": game_paused,
		"game_players": game_players, "revealed_categories": revealed_categories, "game_log": game_log.slice(maxi(0, game_log.size() - 60), game_log.size()),
		"discussion_turn": discussion_turn, "discussion_queue": discussion_queue, "discussion_statements": discussion_statements,
		"vote_choices": vote_choices, "vote_confirmed": vote_confirmed, "vote_tie_candidates": vote_tie_candidates, "blocked_vote_names": blocked_vote_names,
		"player_vote_target": player_vote_target, "bunker_capacity": bunker_capacity, "bunker_resources": bunker_resources,
		"bunker_rooms": bunker_rooms, "current_game_catastrophe": current_game_catastrophe,
		"game_end_reason": game_end_reason, "presentation_index": presentation_index,
		"elimination_winner": elimination_winner, "elimination_votes": elimination_votes,
		"intro_skip_votes": intro_skip_votes, "last_reveal": network_last_reveal,
		"round_event_index": round_event_index, "current_bunker_discovery": current_bunker_discovery
	}

func _network_state_signature(state: Dictionary) -> String:
	var signature := state.duplicate(true)
	signature.erase("phase_seconds_left")
	signature.erase("game_log")
	signature.erase("last_reveal")
	return JSON.stringify(signature)

func _broadcast_network_game_state(force: bool = false) -> void:
	if not network_connected or not network_is_host or not game_session_active:
		return
	var state := _network_game_state()
	var signature := _network_state_signature(state)
	if force or signature != network_last_snapshot_signature:
		network_last_snapshot_signature = signature
		_send_network_message({"type":"game_state", "state":state})
	_send_network_message({"type":"timer_sync", "seconds":phase_seconds_left, "paused":game_paused})

func _apply_network_game_state(state: Dictionary) -> void:
	if state.is_empty():
		return
	var was_session_active := game_session_active
	var was_game_finished := game_finished
	var previous_phase := game_phase
	var previous_round := game_round
	var incoming_phase := str(state.get("game_phase", game_phase))
	var incoming_round := int(state.get("game_round", game_round))
	var incoming_tie_candidates: Array = state.get("vote_tie_candidates", [])
	if incoming_phase == "vote" and (previous_phase != "vote" or previous_round != incoming_round or (not incoming_tie_candidates.is_empty() and incoming_tie_candidates != vote_tie_candidates)):
		network_local_vote_confirmed = false
		player_vote_target = ""
	player_count = int(state.get("player_count", player_count))
	desired_survivors = int(state.get("desired_survivors", desired_survivors))
	selected_style_mode = str(state.get("selected_style_mode", selected_style_mode))
	selected_catastrophe = str(state.get("selected_catastrophe", selected_catastrophe))
	selected_map = str(state.get("selected_map", selected_map))
	current_screen = str(state.get("current_screen", "game"))
	game_session_active = bool(state.get("game_session_active", true))
	game_finished = bool(state.get("game_finished", false))
	game_round = int(state.get("game_round", 1))
	game_phase = str(state.get("game_phase", "profession"))
	phase_seconds_left = int(state.get("phase_seconds_left", phase_seconds_left))
	game_paused = bool(state.get("game_paused", false))
	game_players.clear()
	for person in state.get("game_players", []):
		if person is Dictionary:
			var copy: Dictionary = person.duplicate(true)
			copy["is_local_player"] = str(copy.get("name", "")) == player_name
			game_players.append(copy)
	revealed_categories.clear()
	for category in state.get("revealed_categories", []): revealed_categories.append(str(category))
	game_log.clear()
	for line in state.get("game_log", []): game_log.append(str(line))
	discussion_turn = int(state.get("discussion_turn", 0))
	discussion_queue.clear()
	for nm in state.get("discussion_queue", []): discussion_queue.append(str(nm))
	discussion_statements.clear()
	for statement in state.get("discussion_statements", []): discussion_statements.append(str(statement))
	vote_choices = state.get("vote_choices", {}).duplicate(true)
	vote_confirmed = bool(state.get("vote_confirmed", false))
	vote_tie_candidates.clear()
	for nm in state.get("vote_tie_candidates", []): vote_tie_candidates.append(str(nm))
	blocked_vote_names.clear()
	for nm in state.get("blocked_vote_names", []): blocked_vote_names.append(str(nm))
	if not network_local_vote_confirmed and not network_client_active:
		player_vote_target = str(state.get("player_vote_target", player_vote_target))
	bunker_capacity = int(state.get("bunker_capacity", bunker_capacity))
	bunker_resources = state.get("bunker_resources", bunker_resources).duplicate(true)
	bunker_rooms.clear()
	for room in state.get("bunker_rooms", []):
		if room is Dictionary: bunker_rooms.append(room.duplicate(true))
	current_game_catastrophe = state.get("current_game_catastrophe", {}).duplicate(true)
	game_end_reason = str(state.get("game_end_reason", ""))
	elimination_winner = str(state.get("elimination_winner", elimination_winner))
	elimination_votes = int(state.get("elimination_votes", elimination_votes))
	presentation_index = int(state.get("presentation_index", 0))
	intro_skip_votes = state.get("intro_skip_votes", {}).duplicate(true)
	round_event_index = int(state.get("round_event_index", 0))
	current_bunker_discovery = str(state.get("current_bunker_discovery", ""))
	var reveal_data: Dictionary = state.get("last_reveal", {})
	var reveal_id := str(reveal_data.get("id", ""))
	var render_signature := "%s|%s|%s|%s|%s|%s|%s" % [current_screen, game_phase, game_round, discussion_turn, _alive_count(), JSON.stringify(vote_choices), _revealed_state_signature()]
	if render_signature != network_last_render_signature:
		network_last_render_signature = render_signature
		if current_screen == "catastrophe_intro":
			_show_catastrophe_intro()
		elif current_screen == "player_intro":
			_show_player_presentation()
		elif current_screen == "voting" or game_phase == "vote":
			_show_voting_screen()
		elif current_screen == "elimination":
			_show_elimination_scene(elimination_winner, elimination_votes)
		elif current_screen == "game" or game_phase in ["profession", "discussion", "vote_prep", "result", "private_review"]:
			_show_gameplay()
	if not reveal_id.is_empty() and reveal_id != network_last_reveal_id:
		network_last_reveal_id = reveal_id
		if str(reveal_data.get("name", "")) != player_name or str(reveal_data.get("category", "")) != "":
			_show_character_reveal_splash(str(reveal_data.get("name", "Участник")), str(reveal_data.get("category", "Характеристика")), str(reveal_data.get("value", "—")))
	if network_client_active and not was_session_active and game_session_active:
		games_played += 1
		_save_user_settings()
	if network_client_active and not was_game_finished and game_finished:
		_award_profile_xp(50 + _alive_count() * 10)
		if not _find_person(player_name).is_empty() and bool(_find_person(player_name).get("alive", false)):
			games_won += 1
			people_saved += _alive_count()
			best_survivor_count = maxi(best_survivor_count, _alive_count())
		else:
			people_exiled += 1
		_save_user_settings()
	network_status = "СЕТЕВАЯ ПАРТИЯ • %s • РАУНД %d" % [game_phase.to_upper(), game_round]

func _revealed_state_signature() -> String:
	var rows: Array[String] = []
	for person in game_players:
		rows.append(str(person.get("name", "")) + ":" + ",".join(PackedStringArray(person.get("revealed", []))))
	return "|".join(PackedStringArray(rows))

func _send_network_action(action: Dictionary) -> void:
	if network_client_active and network_connected:
		_send_network_message({"type":"action", "action":action})

func _handle_network_game_action(sender: String, action: Dictionary) -> void:
	if sender.is_empty() or action.is_empty() or game_finished:
		return
	match str(action.get("action", "")):
		"reveal":
			if game_phase != "discussion" or discussion_turn >= discussion_queue.size() or discussion_queue[discussion_turn] != sender:
				return
			var category := str(action.get("category", ""))
			if not CARD_CATEGORIES.has(category) or category == "Профессия": return
			var person := _find_person(sender)
			if person.is_empty() or not bool(person.get("alive", true)) or person.get("revealed", []).has(category): return
			person["revealed"].append(category)
			for i in range(game_players.size()):
				if str(game_players[i].get("name", "")) == sender:
					game_players[i] = person
					break
			discussion_revealed_this_turn.append(sender)
			discussion_reveal_counts[sender] = _count_revealed_nonprofession(person)
			game_log.append("%s раскрыл характеристику: %s." % [sender, category])
			if is_instance_valid(phase_timer): phase_timer.stop()
			pending_resume_discussion_turn = true
			var reveal_id := "%d|%s|%s|%s" % [game_round, sender, category, Time.get_ticks_msec()]
			network_last_reveal = {"id":reveal_id, "name":sender, "category":category, "value":str(person.get(_category_key(category), "—"))}
			_show_gameplay()
			_show_character_reveal_splash(sender, category, str(person.get(_category_key(category), "—")))
		"vote":
			if game_phase != "vote" or vote_choices.has(sender): return
			var target_name := str(action.get("target", ""))
			var target_person := _find_person(target_name)
			if target_person.is_empty() or not bool(target_person.get("alive", true)) or target_name == sender: return
			vote_choices[sender] = target_name
			game_log.append("%s подтвердил голос." % sender)
			_broadcast_network_game_state(true)
		"intro_skip":
			if current_screen != "catastrophe_intro": return
			intro_skip_votes[sender] = bool(action.get("skip", false))
			if _intro_skip_yes_count() > game_players.size() / 2:
				_enter_gameplay_after_intro()
			else:
				_show_catastrophe_intro()
			_broadcast_network_game_state(true)
		"skip_turn":
			if game_phase == "discussion" and discussion_turn < discussion_queue.size() and discussion_queue[discussion_turn] == sender:
				_next_discussion_turn()
				_broadcast_network_game_state(true)
		"ability_open":
			network_ability_timer_was_running = is_instance_valid(phase_timer) and not phase_timer.is_stopped()
			game_paused = true
			if is_instance_valid(phase_timer): phase_timer.stop()
			game_log.append("Пауза: %s выбирает спецвозможность." % sender)
			_show_gameplay()
			_broadcast_network_game_state(true)
		"ability_cancel":
			game_paused = false
			if network_ability_timer_was_running and is_instance_valid(phase_timer) and game_session_active: phase_timer.start()
			network_ability_timer_was_running = false
			game_log.append("Пауза снята.")
			_show_gameplay()
			_broadcast_network_game_state(true)
		"ability":
			_apply_network_special_ability(sender, str(action.get("ability", "")))

func _format_playtime(seconds_total: int) -> String:
	var hours := seconds_total / 3600
	var minutes := (seconds_total % 3600) / 60
	var seconds := seconds_total % 60
	if hours > 0:
		return "%d ч %02d мин" % [hours, minutes]
	if minutes > 0:
		return "%d мин %02d сек" % [minutes, seconds]
	return "%d сек" % seconds

