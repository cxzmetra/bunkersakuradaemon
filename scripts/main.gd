func _show_lobby_moderation() -> void:
	current_screen = "lobby_moderation"
	_clear_screen()
	_background(self, 0.82)
	var page := _page()
	_header(page, "МОДЕРАЦИЯ ЛОББИ", "Локальные команды хоста для ИИ-участников этой офлайн-сборки")
	var warning := _panel(page, Color("#160d0a"), ORANGE)
	_label(warning, "Модерация ИИ действует локально. Сетевые игроки сейчас могут покинуть комнату; кик/бан сетевых участников и передача хоста пока не реализованы.", 13, CREAM)
	for i in range(mini(player_count - 1, AI_NAMES.size())):
		var nm := str(AI_NAMES[i])
		var p := _panel(page, Color("#101213"), RED if lobby_bans.has(nm) else (ORANGE if lobby_kicks.has(nm) else BORDER))
		var row := HBoxContainer.new()
		row.add_theme_constant_override("separation", 8)
		p.add_child(row)
		var info := VBoxContainer.new()
		info.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		row.add_child(info)
		_label(info, nm, 16, CREAM)
		var state := "ЗАБАНЕН В ЭТОЙ УСТАНОВКЕ" if lobby_bans.has(nm) else ("КИКНУТ ИЗ ЭТОГО ЛОББИ" if lobby_kicks.has(nm) else ("ЗАГЛУШЕН" if lobby_mutes.has(nm) else "В ЛОББИ • ИИ"))
		_label(info, state, 10, RED if lobby_bans.has(nm) or lobby_kicks.has(nm) else (ORANGE if lobby_mutes.has(nm) else MUTED))
		if not lobby_bans.has(nm) and not lobby_kicks.has(nm):
			_button(row, "СНЯТЬ МУТ" if lobby_mutes.has(nm) else "МУТ", func(): _toggle_lobby_mute(nm), lobby_mutes.has(nm))
			_button(row, "КИК", func(): _kick_lobby_bot(nm), false)
			_button(row, "БАН", func(): _ban_lobby_bot(nm), false)
		else:
			_button(row, "ВОССТАНОВИТЬ", func(): _restore_lobby_bot(nm), true)
	_button(page, "← НАЗАД В ЛОББИ", _show_lobby, true)

func _toggle_lobby_mute(nm: String) -> void:
	if lobby_mutes.has(nm):
		lobby_mutes.erase(nm)
	else:
		lobby_mutes.append(nm)
	_show_lobby_moderation()

func _kick_lobby_bot(nm: String) -> void:
	if not lobby_kicks.has(nm):
		lobby_kicks.append(nm)
	game_log.append("Хост исключил ИИ-участника %s из локального лобби." % nm)
	_show_lobby_moderation()

func _ban_lobby_bot(nm: String) -> void:
	if not lobby_bans.has(nm):
		lobby_bans.append(nm)
	if not lobby_kicks.has(nm):
		lobby_kicks.append(nm)
	if lobby_mutes.has(nm):
		lobby_mutes.erase(nm)
	_show_lobby_moderation()

func _restore_lobby_bot(nm: String) -> void:
	if lobby_kicks.has(nm): lobby_kicks.erase(nm)
	if lobby_bans.has(nm): lobby_bans.erase(nm)
	_show_lobby_moderation()

func _sync_lobby_config() -> void:
	for i in range(created_lobbies.size()):
		if str(created_lobbies[i].code) == lobby_code:
			created_lobbies[i].players = player_count
			created_lobbies[i].map = selected_map
			created_lobbies[i].catastrophe = selected_catastrophe
			created_lobbies[i].private = private_lobby

