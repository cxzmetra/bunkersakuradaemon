	var fullscreen_button := _button(mode_row, "● ПОЛНОЭКРАННЫЙ" if fullscreen_enabled else "ПОЛНОЭКРАННЫЙ РЕЖИМ", func(): _set_window_mode(true), fullscreen_enabled)
	window_button.custom_minimum_size.y = 42
	fullscreen_button.custom_minimum_size.y = 42
	_button(stack, "V-SYNC: ВКЛ" if vsync_enabled else "V-SYNC: ВЫКЛ", _toggle_vsync, vsync_enabled).custom_minimum_size.y = 38

	_label(stack, "ИНТЕРФЕЙС", 14, ORANGE)
	_button(stack, "ЭФФЕКТЫ АНИМАЦИИ: ВКЛ" if screen_shake_enabled else "ЭФФЕКТЫ АНИМАЦИИ: ВЫКЛ", _toggle_shake, screen_shake_enabled).custom_minimum_size.y = 38
	var scale_row := HBoxContainer.new()
	scale_row.add_theme_constant_override("separation", 12)
	stack.add_child(scale_row)
	_label(scale_row, "Масштаб интерфейса", 13, CREAM)
	var scale_option := OptionButton.new()
	for s in [0.9, 1.0, 1.1]:
		scale_option.add_item("%d%%" % int(s * 100.0))
	scale_option.select(1 if ui_scale == 1.0 else (0 if ui_scale < 1.0 else 2))
	scale_option.item_selected.connect(func(i: int):
		ui_scale = [0.9, 1.0, 1.1][i]
		_apply_ui_scale()
		_save_user_settings()
	)
	scale_row.add_child(scale_option)
	_button(page, "← В ГЛАВНОЕ МЕНЮ", _show_main_menu, false)
func _set_window_mode(use_fullscreen: bool) -> void:
	fullscreen_enabled = use_fullscreen
	if fullscreen_enabled:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)
	else:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)
		DisplayServer.window_set_size(Vector2i(1280, 720))
		DisplayServer.window_set_position(Vector2i(80, 60))
	_save_user_settings()
	_show_settings()

func _choose_avatar() -> void:
	if profile_file_dialog == null or not is_instance_valid(profile_file_dialog):
		profile_file_dialog = FileDialog.new()
		profile_file_dialog.title = "Выберите аватар"
		profile_file_dialog.file_mode = FileDialog.FILE_MODE_OPEN_FILE
		profile_file_dialog.access = FileDialog.ACCESS_FILESYSTEM
		profile_file_dialog.add_filter("*.png, *.jpg, *.jpeg, *.webp", "Изображения")
		profile_file_dialog.file_selected.connect(_load_avatar)
		add_child(profile_file_dialog)
	profile_file_dialog.popup_centered(Vector2i(720, 480))

func _load_avatar(path: String) -> void:
	var image := Image.new()
	var err := image.load(path)
	if err != OK:
		_show_settings()
		return
	avatar_path = path
	avatar_texture = ImageTexture.create_from_image(image)
	_save_user_settings()
	_show_settings()

func _toggle_vsync() -> void:
	vsync_enabled = not vsync_enabled
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_ENABLED if vsync_enabled else DisplayServer.VSYNC_DISABLED)
	_save_user_settings()
	_show_settings()

func _toggle_shake() -> void:
	screen_shake_enabled = not screen_shake_enabled
	_save_user_settings()
	_show_settings()

func _apply_ui_scale() -> void:
	get_tree().root.content_scale_factor = ui_scale

