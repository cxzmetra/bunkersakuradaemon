		var filter_button := _button(filter_row, filter_name, _set_lobby_filter.bind(filter_name), lobby_filter == filter_name)
		filter_button.custom_minimum_size.x = 110
	var search_panel := _panel(page, Color("#0b0d0e"), BORDER)
	var search_row := HBoxContainer.new()
	search_row.add_theme_constant_override("separation", 8)
	search_panel.add_child(search_row)
	var lobby_search := LineEdit.new()
	lobby_search.text = lobby_search_text
	lobby_search.placeholder_text = "Поиск по названию или коду комнаты..."
	lobby_search.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	lobby_search.text_changed.connect(func(value: String): lobby_search_text = value)
	search_row.add_child(lobby_search)
	_button(search_row, "НАЙТИ", _show_lobby_browser, true)
	var list_panel := _panel(page, Color("#0a0b0b"))
	var list_stack := VBoxContainer.new()
	list_stack.add_theme_constant_override("separation", 10)
	list_panel.add_child(list_stack)
	var title_row := HBoxContainer.new()
	list_stack.add_child(title_row)
	_label(title_row, "ДОСТУПНЫЕ ЛОББИ", 19, CREAM)
	var visible_lobbies: Array[Dictionary] = []
	for candidate in created_lobbies:
		var show_candidate := true
		if lobby_filter == "Открытые": show_candidate = not bool(candidate.private)
		elif lobby_filter == "Закрытые": show_candidate = bool(candidate.private)
		elif lobby_filter == "Заполненные": show_candidate = bool(candidate.filled)
		elif lobby_filter == "Доступные": show_candidate = not bool(candidate.filled)
		elif lobby_filter == "Избранное": show_candidate = favorite_codes.has(str(candidate.code))
		elif lobby_filter == "Недавние": show_candidate = recent_codes.has(str(candidate.code))
		var search_text := lobby_search_text.strip_edges().to_lower()
		if not search_text.is_empty():
			var lobby_identity := (str(candidate.get("name", "")) + " " + str(candidate.get("code", ""))).to_lower()
			show_candidate = show_candidate and lobby_identity.contains(search_text)
		if show_candidate: visible_lobbies.append(candidate)
	_label(title_row, "%d КОМН." % visible_lobbies.size(), 11, GREEN)
	if visible_lobbies.is_empty():
		var empty := _panel(list_stack, Color("#111313"), BORDER)
		empty.custom_minimum_size.y = 180
		var empty_stack := VBoxContainer.new()
		empty_stack.alignment = BoxContainer.ALIGNMENT_CENTER
		empty_stack.add_theme_constant_override("separation", 8)
		empty.add_child(empty_stack)
		_label(empty_stack, "НЕТ КОМНАТ В ЭТОМ ФИЛЬТРЕ", 20, MUTED)
		_label(empty_stack, "Создай лобби или выбери другой фильтр. Комнаты хранятся только до закрытия приложения.", 13, MUTED)
	else:
		for lobby in visible_lobbies:
			var card := _panel(list_stack, Color("#111313"), ORANGE if str(lobby.code) == lobby_code else BORDER)
			var card_row := HBoxContainer.new()
			card_row.add_theme_constant_override("separation", 14)
			card.add_child(card_row)
			var details := VBoxContainer.new()
			details.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			details.add_theme_constant_override("separation", 4)
			card_row.add_child(details)
			_label(details, str(lobby.name), 17, CREAM)
			_label(details, "%s  •  %s  •  %d/%d игроков  •  %s ГОТОВ" % [str(lobby.code), str(lobby.get("access", "По коду")).to_upper(), int(lobby.get("ready", 1)), int(lobby.players), str(lobby.map)], 11, MUTED)
			var controls := VBoxContainer.new()
			controls.custom_minimum_size.x = 190
			card_row.add_child(controls)
			var fav_text := "★ ИЗБРАННОЕ" if favorite_codes.has(str(lobby.code)) else "☆ В ИЗБРАННОЕ"
			_button(controls, fav_text, func(): _toggle_favorite(str(lobby.code)), false)
			_button(controls, "КОПИРОВАТЬ КОД", func(): DisplayServer.clipboard_set(str(lobby.code)), false)
			_button(controls, "ВОЙТИ  →", func(): _join_lobby(str(lobby.code)), true)
	var spacer := Control.new()
	spacer.size_flags_vertical = Control.SIZE_EXPAND_FILL
	page.add_child(spacer)
	_button(page, "← ГЛАВНОЕ МЕНЮ", _show_main_menu, false)

func _set_lobby_filter(value: String) -> void:
	lobby_filter = value
	_show_lobby_browser()

func _toggle_favorite(code: String) -> void:
	if favorite_codes.has(code):
		favorite_codes.erase(code)
	else:
		favorite_codes.append(code)
	_show_lobby_browser()

func _create_lobby() -> void:
	lobby_code = "ROOM-%04d" % randi_range(1000, 9999)
	var new_lobby: Dictionary = {
		"code": lobby_code,
		"name": "Бункер %s" % lobby_code,
		"private": private_lobby,
		"access": "По коду" if private_lobby else "Открытая",
		"players": player_count,
		"filled": false,
		"ready": 1,
		"map": selected_map,
		"catastrophe": selected_catastrophe,
		"favorites": false
	}
	last_lobby_code = lobby_code
	lobby_kicks.clear()
	lobby_mutes.clear()
	created_lobbies.append(new_lobby)
	if recent_codes.has(lobby_code): recent_codes.erase(lobby_code)
	recent_codes.push_front(lobby_code)
	_show_lobby()

