func _repair_room(room_name: String) -> void:
	var can_repair := false
	for person in game_players:
		if bool(person.get("alive", false)) and str(person.get("profession", "")).to_lower().contains("инженер"):
			can_repair = true
	if not can_repair:
		game_log.append("Ремонт невозможен: среди живых нет инженера.")
	else:
		for i in range(bunker_rooms.size()):
			if str(bunker_rooms[i].get("name", "")) == room_name:
				bunker_rooms[i].state = "СТАБИЛЕН"
				bunker_rooms[i].integrity = 100
				bunker_resources["energy"] = maxf(0.0, float(bunker_resources.energy) - 8.0)
				game_log.append(room_name + " восстановлен инженером. Потрачено 8% энергии.")
				break
	_inspect_room(room_name)

func _advance_bunker_simulation() -> void:
	var survivors := maxi(1, _alive_count())
	bunker_resources["energy"] = maxf(0.0, float(bunker_resources.energy) - 4.0 - survivors * 0.8)
	bunker_resources["food"] = maxf(0.0, float(bunker_resources.food) - survivors * 2.2)
	bunker_resources["water"] = maxf(0.0, float(bunker_resources.water) - survivors * 2.0)
	bunker_resources["oxygen"] = maxf(0.0, float(bunker_resources.oxygen) - survivors * 1.5)
	room_event_log.clear()
	# Missing engineer can trigger reactor or ventilation failures after two rounds.
	var engineer_alive := false
	for person in game_players:
		if bool(person.alive) and str(person.get("profession", "")).to_lower().contains("инженер"):
			engineer_alive = true
	if not engineer_alive and game_round >= 2:
		for room in bunker_rooms:
			if str(room.name) in ["Реактор", "Вентиляция"] and str(room.state) == "СТАБИЛЕН":
				room.state = "ТРЕБУЕТ РЕМОНТА"
				room.integrity = 65
				room_event_log.append(str(room.name) + " повреждён: нет инженера.")
				game_log.append(str(room.name) + " повреждён — в группе нет инженера.")
				break
	if float(bunker_resources.energy) <= 15.0:
		game_log.append("АВАРИЯ: критически мало энергии. Вентиляция работает нестабильно.")
	if float(bunker_resources.food) <= 20.0:
		game_log.append("ТРЕВОГА: продовольствие заканчивается.")
	if float(bunker_resources.water) <= 20.0:
		game_log.append("ТРЕВОГА: запас воды критически низок.")
	if float(bunker_resources.oxygen) <= 20.0:
		game_log.append("ТРЕВОГА: уровень кислорода опасно низок.")
	if float(bunker_resources.energy) <= 0.0 or float(bunker_resources.oxygen) <= 0.0:
		game_end_reason = "Система жизнеобеспечения отказала."
		_finish_game()

func _on_phase_timer_tick() -> void:
	if network_client_active:
		return
	if game_paused:
		return
	if current_screen == "catastrophe_intro":
		phase_seconds_left -= 1
		if phase_seconds_left <= 0:
			_enter_gameplay_after_intro()
		else:
			_show_catastrophe_intro()
		return
	if current_screen == "player_intro":
		phase_seconds_left -= 1
		if phase_seconds_left <= 0:
			_advance_player_presentation()
		return
	if current_screen != "game" and current_screen != "voting" and current_screen != "elimination":
		if is_instance_valid(phase_timer):
			phase_timer.stop()
		return
	if game_phase != "private_review" and game_phase != "profession" and game_phase != "discussion" and game_phase != "reveal" and game_phase != "vote_prep" and game_phase != "vote" and game_phase != "result":
		if is_instance_valid(phase_timer):
			phase_timer.stop()
		return
	phase_seconds_left -= 1
	if phase_seconds_left <= 0:
		phase_seconds_left = 0
		if game_phase == "private_review":
			_reveal_professions()
		elif game_phase == "profession":
			_dismiss_reveal_splash()
		elif game_phase == "discussion":
			_next_discussion_turn()
		elif game_phase == "reveal":
			_reveal_extra_category()
		elif game_phase == "vote_prep":
			_begin_vote()
		elif game_phase == "result":
			_next_round()
		elif game_phase == "vote":
			if not vote_confirmed:
				vote_confirmed = true
				if player_vote_target == "":
					player_vote_target = _choose_ai_vote_target()
				vote_choices[player_name] = player_vote_target
			_resolve_vote()
		return
	if current_screen == "game":
		_show_gameplay()
	elif current_screen == "voting":
		_show_voting_screen()

