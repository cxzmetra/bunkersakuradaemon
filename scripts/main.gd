func _start_game() -> void:
	if network_connected and not network_is_host:
		network_status = "ОЖИДАНИЕ ЗАПУСКА ОТ ХОСТА"
		return
	if network_connected and network_is_host:
		player_count = maxi(player_count, network_room_players.size())
	network_last_reveal = {}
	network_last_reveal_id = ""
	network_local_vote_confirmed = false
	game_paused = false
	discussion_bonus_seconds.clear()
	_sync_lobby_config()
	# Scenario and bunker are always random. The archive pages are informational only.
	var random_cat: Dictionary = CATASTROPHES[randi_range(0, CATASTROPHES.size() - 1)]
	selected_catastrophe = str(random_cat.name)
	var random_map: Dictionary = MAPS[randi_range(0, MAPS.size() - 1)]
	selected_map = str(random_map.name)
	random_catastrophe_enabled = true
	random_bunker_enabled = true
	game_session_active = true
	menu_paused_game = false
	_sync_lobby_config()
	game_round = 1
	game_phase = "profession"
	discussion_turn = 0
	discussion_revealed_this_turn.clear()
	discussion_reveal_counts.clear()
	discussion_queue.clear()
	discussion_statements.clear()
	revealed_categories.clear()
	human_revealed_categories.clear()
	game_log.clear()
	reveal_overlay_queue.clear()
	pending_vote_after_reveal = false
	pending_discussion_after_reveal = false
	if is_instance_valid(active_reveal_overlay):
		active_reveal_overlay.queue_free()
	active_reveal_overlay = null
	game_finished = false
	game_players.clear()
	current_game_catastrophe = {}
	for item in CATASTROPHES:
		if str(item.name) == selected_catastrophe:
			current_game_catastrophe = item
			break
	_generate_game_players()
	_seed_ai_relationships()
	_initialize_bunker()
	for person in game_players:
		if bool(person.get("alive", true)) and game_round == 1:
			person.revealed = []
	vote_choices.clear()
	vote_confirmed = false
	vote_tie_candidates.clear()
	vote_reveal_stage = false
	room_event_log.clear()
	radio_messages.clear()
	game_end_reason = ""
	games_played += 1
	_save_user_settings()
	game_phase = "intro"
	phase_seconds_left = 120
	intro_skip_votes.clear()
	intro_vote_cast = false
	relationship_scores.clear()
	discussion_reveal_counts.clear()
	current_screen = "catastrophe_intro"
	if is_instance_valid(phase_timer):
		phase_timer.start()
	_show_catastrophe_intro()
	if network_connected and network_is_host:
		_send_network_message({"type":"start_game", "room":network_room_code, "player_count":player_count, "style":selected_style_mode, "survivors":desired_survivors})
		network_last_snapshot_signature = ""
		_broadcast_network_game_state(true)

func _generate_game_players() -> void:
	var roster_names: Array[String] = [player_name]
	var human_names: Array[String] = [player_name]
	if network_connected and network_is_host:
		for net_player in network_room_players:
			var net_name := str(net_player.get("name", ""))
			if not net_name.is_empty() and not roster_names.has(net_name):
				roster_names.append(net_name)
				human_names.append(net_name)
	for ai_name in AI_NAMES:
		if not roster_names.has(str(ai_name)):
			roster_names.append(str(ai_name))
	var used_names: Array[String] = []
	for i in range(mini(clampi(player_count, 4, 12), roster_names.size())):
		var nm := str(roster_names[i])
		if i > 0 and not human_names.has(nm) and (lobby_kicks.has(nm) or lobby_bans.has(nm)):
			continue
		if used_names.has(nm):
			nm = "ВЫЖИВШИЙ-%02d" % (i + 1)
		used_names.append(nm)
		var person := {
			"name": nm,
			"is_human": human_names.has(nm),
			"alive": true,
			"profession": _pick_mode_value("profession", PROFESSIONS),
			"biology": _pick_mode_value("biology", BIOLOGIES + EXTRA_BIOLOGIES),
			"facts": _pick_mode_value("facts", FACTS),
			"special_condition": _pick(SPECIAL_CONDITIONS),
			"hobby": _pick_mode_value("hobby", HOBBIES),
			"health": _pick_mode_value("health", HEALTHS + EXTRA_HEALTHS),
			"baggage": _pick_mode_value("baggage", BAGGAGE + EXTRA_BAGGAGE),
			"trait": _pick_mode_value("trait", TRAITS + EXTRA_TRAITS),
			"secret": _pick_mode_value("secret", SECRETS + EXTRA_SECRETS),
			"secret_item": _pick(["Аварийный радиомаяк", "Запас антибиотиков", "Набор инструментов", "Фильтр для воды", "Карта технических тоннелей", "Ничего ценного"]),
			"secret_goal": _pick(["Защитить медика", "Сохранить реактор", "Найти сигнал с поверхности", "Не допустить исключения друга", "Получить контроль над запасами"]),
			"secret_problem": _pick(["Скрывает хроническую болезнь", "Панически боится замкнутых пространств", "Имеет зависимость", "Не спал несколько суток", "Скрытых проблем не обнаружено"]),
			"trust": randi_range(-2, 2),
			"suspicion": randi_range(0, 3),
			"revealed": [],
			"special_abilities": _draw_two_special_abilities(),
			"special_used": [],
			"xp": 0,
			"level": 1,
			"score": 0
		}
		person.score = _survival_score(person)
		game_players.append(person)
	_ensure_player_scenario_relevance()

func _pick(values: Array) -> String:
	return str(values[randi_range(0, values.size() - 1)])

