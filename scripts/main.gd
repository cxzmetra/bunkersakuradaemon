 {"name":"Больничный изолятор «Сектор 9»", "desc":"Специализированный медицинский изолятор с отрицательным давлением в палатах, стерилизационными шлюзами и запасом диагностического оборудования. Он создавался для сдерживания опасных инфекций, но часть фильтров отработала ресурс, а холодильники с препаратами пережили отключение питания.", "capacity":"6–11 человек", "area":"3 700 м²", "feature":"Изоляторы • диагностика • стерилизация", "icon":"✚", "food":"5 месяцев", "water":"Медицинская система очистки", "risk":"Нарушение холодовой цепи"},
 {"name":"Городской дата-центр", "desc":"Укреплённый дата-центр имеет мощные генераторы, системы охлаждения и технические помещения. Серверы хранят карты, архивы и научные данные, которые могут помочь восстановить цивилизацию. Однако теплоотвод требует энергии, а автономная система управления повреждена.", "capacity":"5–9 человек", "area":"2 200 м²", "feature":"Серверы • резервное питание • архив", "icon":"⌘", "food":"4 месяца", "water":"Промышленный контур", "risk":"Перегрев и сбой автоматизации"},
 {"name":"Морской маяк-крепость", "desc":"Старый маяк на скальном острове усилен как убежище для смотрителей. Верхние уровни открыты ветрам, зато под скалой есть цистерны и аварийный склад. Доставка невозможна, а сильный шторм может разрушить причал и отрезать единственный путь наружу.", "capacity":"3–6 человек", "area":"900 м²", "food":"2 месяца", "water":"Дождевая цистерна", "feature":"Радиомаяк • скальные хранилища", "icon":"⌁", "risk":"Шторм и изоляция"},
 {"name":"Бункер «Последний архив»", "desc":"Секретное хранилище построено для сохранения книг, генетических образцов, семян и культурных артефактов. Температура и влажность контролируются, но помещения проектировались не для долгого проживания людей. Придётся решать, что важнее: сохранить наследие или переоборудовать хранилища в жильё.", "capacity":"5–8 человек", "area":"2 000 м²", "food":"3 месяца", "water":"Ограниченный резерв", "feature":"Архив • генобанк • библиотека", "icon":"▤", "risk":"Мало жилых помещений"},
 {"name":"Промышленный реакторный блок", "desc":"Обслуживающий блок старой электростанции имеет защищённый командный пункт, запас деталей и мощные системы фильтрации. Он может обеспечить энергией целый район, если реактор безопасно остановлен. Показания приборов противоречивы, а часть технических журналов отсутствует.", "capacity":"7–12 человек", "area":"4 300 м²", "food":"6 месяцев", "water":"Технический контур требует проверки", "feature":"Энергоблок • ремонтные цеха", "icon":"⚡", "risk":"Неизвестное состояние энергосистемы"},
 {"name":"Пещерный монастырь", "desc":"Естественная пещерная сеть была переоборудована в убежище задолго до катастрофы. Источник воды, кладовые и толстые каменные стены дают базовую защиту. Здесь мало современной техники, зато есть пространство, тишина и старые карты подземных ходов. Не все проходы нанесены на план.", "capacity":"6–10 человек", "area":"2 700 м²", "food":"4 месяца", "water":"Естественный источник", "feature":"Кладовые • мастерская • подземные ходы", "icon":"⌂", "risk":"Неизученные пещерные ответвления"}
]
class PersonIcon extends Control:
	var tint: Color = Color("#9b9da0")

	func _draw() -> void:
		var cx := size.x * 0.5
		var head_r := minf(size.x, size.y) * 0.16
		var head_center := Vector2(cx, size.y * 0.28)
		draw_arc(head_center, head_r, 0.0, TAU, 24, tint, 2.5, true)
		var shoulder_y := size.y * 0.53
		draw_line(Vector2(cx, head_center.y + head_r + 3.0), Vector2(cx, size.y * 0.67), tint, 2.5, true)
		draw_arc(Vector2(cx, size.y * 0.88), size.x * 0.27, PI, TAU, 28, tint, 2.5, true)
		draw_line(Vector2(cx - size.x * 0.26, shoulder_y), Vector2(cx - size.x * 0.17, size.y * 0.76), tint, 2.5, true)
		draw_line(Vector2(cx + size.x * 0.26, shoulder_y), Vector2(cx + size.x * 0.17, size.y * 0.76), tint, 2.5, true)

const CATASTROPHES := [
 {"name":"Ядерная зима", "desc":"Масштабный обмен ядерными ударами разрушил крупнейшие города и поднял в атмосферу пыль, сажу и радиоактивные частицы. Солнечный свет почти не достигает поверхности. Температура падает, урожаи гибнут, а радиоактивные осадки делают выход наружу опасным. В ближайшие годы главными угрозами станут холод, повреждение фильтров, дефицит витаминов и психологическое истощение из-за изоляции.", "danger":"Экстремальный холод • радиация • голод", "level":"КРИТИЧЕСКИЙ", "effect":"Ценятся инженеры, медики, агрономы и специалисты по энергии.", "icon":"❄"},
