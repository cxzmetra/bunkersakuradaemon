		match category:
			"profession": values.append_array(HORROR_PROFESSIONS)
			"hobby": values.append_array(HORROR_HOBBIES)
			"facts": values.append_array(["Слышал голос по отключённому радио", "Нашёл фотографии людей, которых никто не помнит", "Однажды проснулся в закрытом помещении без объяснения", "Умеет замечать следы присутствия в пустых комнатах"])
			"trait": values.append_array(["Мрачно наблюдательный", "Не переносит тишину", "Подозрительно спокоен", "Одержим поиском закономерностей"])
			"secret": values.append_array(["Видел силуэт за гермодверью", "Слышал стук из замурованного отсека", "Получил сообщение со своим именем до эвакуации", "Скрывает контакт с неизвестным объектом"])
			"biology": values.append_array(["31 год, не помнит часть прошлого месяца", "46 лет, странная реакция на инфразвук"])
			"baggage": values.append_array(["Плёнка с неразборчивой записью", "Опечатанный контейнер", "Дозиметр с невозможными показаниями", "Ключ без замочной скважины"])
			"health": values.append_array(["Периодически слышит несуществующий сигнал", "Не переносит полную темноту", "Неизвестная реакция на местную пыль"])
			"special_condition": values.append_array(["Один раз может проверить закрытую дверь без расхода времени", "Должен выбрать между безопасностью и любопытством"])
