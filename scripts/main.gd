func _button(parent: Control, text_value: String, callback: Callable, primary: bool = false) -> Button:
	var b := Button.new()
	b.text = text_value
	b.custom_minimum_size = Vector2(0, 48)
	b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	b.focus_mode = Control.FOCUS_ALL
	b.mouse_filter = Control.MOUSE_FILTER_STOP
	b.add_theme_font_size_override("font_size", 14)
	b.add_theme_color_override("font_color", Color("#101010") if primary else CREAM)
	b.add_theme_color_override("font_hover_color", CREAM if primary else ORANGE)
	b.add_theme_stylebox_override("normal", _style(ORANGE if primary else Color("#171819"), ORANGE if primary else BORDER))
	b.add_theme_stylebox_override("hover", _style(Color("#d9430a") if primary else Color("#222426"), ORANGE))
	b.add_theme_stylebox_override("pressed", _style(ORANGE_DARK, ORANGE))
	b.pivot_offset = Vector2(0, 0)
	b.mouse_entered.connect(func():
		var tw := create_tween()
		tw.tween_property(b, "modulate", Color(1.0, 0.86, 0.72), 0.10)
	)
	b.mouse_exited.connect(func():
		var tw := create_tween()
		tw.tween_property(b, "modulate", Color.WHITE, 0.12)
	)
	b.pressed.connect(func():
		var tw := create_tween()
		tw.tween_property(b, "scale", Vector2(0.985, 0.985), 0.045)
		tw.tween_property(b, "scale", Vector2.ONE, 0.07)
		callback.call()
	)
	parent.add_child(b)
	return b

