func _intro_skip_yes_count() -> int:
	var total := 0
	for value in intro_skip_votes.values():
		if bool(value): total += 1
	return total

func _cast_intro_skip_vote(skip: bool) -> void:
	if network_client_active:
		_send_network_action({"action":"intro_skip", "skip":skip})
		intro_vote_cast = true
		return
	if intro_vote_cast or current_screen != "catastrophe_intro": return
	intro_vote_cast = true
	intro_skip_votes[player_name] = skip
	# Local AI participants vote once. Their choice is varied but deterministic enough to be readable.
	for person in game_players:
		var nm := str(person.get("name", ""))
		if nm == player_name: continue
		if network_connected and network_is_host and bool(person.get("is_human", false)):
			continue
		var wants_skip := randf() < (0.62 if skip else 0.28)
		intro_skip_votes[nm] = wants_skip
	game_log.append("Голосование за пропуск вступления: %d из %d." % [_intro_skip_yes_count(), game_players.size()])
	if _intro_skip_yes_count() > game_players.size() / 2:
		_enter_gameplay_after_intro()
	else:
		_show_catastrophe_intro()
		game_log.append("Большинство не поддержало пропуск вступления — чтение продолжается до конца таймера.")

func _enter_gameplay_after_intro() -> void:
	if is_instance_valid(phase_timer):
		phase_timer.stop()
	presentation_index = 0
	current_screen = "player_intro"
	phase_seconds_left = 3
	if is_instance_valid(phase_timer):
		phase_timer.start()
	_show_player_presentation()

