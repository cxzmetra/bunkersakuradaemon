func _skip_reveal_animation() -> void:
	if not is_instance_valid(active_reveal_overlay):
		return
	if game_phase != "profession":
		_dismiss_reveal_splash()
		return
	var overlay := active_reveal_overlay
	var wait_left := 0.1
	for child in overlay.get_children():
		if child is Timer:
			wait_left = maxf(0.1, child.time_left)
			child.stop()
	active_reveal_overlay = null
	overlay.queue_free()
	if not reveal_overlay_queue.is_empty():
		_display_next_reveal_overlay()
		return
	# Hiding the visual does not skip the 10-second cadence between professions.
	var cadence_timer := Timer.new()
	cadence_timer.one_shot = true
	cadence_timer.wait_time = wait_left
	cadence_timer.timeout.connect(_reveal_next_profession)
	add_child(cadence_timer)
	cadence_timer.start()
	_show_gameplay()

func _dismiss_reveal_splash() -> void:
	if not is_instance_valid(active_reveal_overlay):
		active_reveal_overlay = null
		return
	var old_overlay := active_reveal_overlay
	active_reveal_overlay = null
	var tween := create_tween()
	tween.tween_property(old_overlay, "modulate:a", 0.0, 0.18)
	tween.tween_callback(old_overlay.queue_free)
	if network_client_active:
		return
	if not reveal_overlay_queue.is_empty():
		tween.tween_callback(_display_next_reveal_overlay)
	elif game_phase == "profession":
		tween.tween_callback(_reveal_next_profession)
	elif pending_vote_after_reveal:
		pending_vote_after_reveal = false
		tween.tween_callback(_begin_vote)
	elif pending_resume_discussion_turn:
		pending_resume_discussion_turn = false
		if is_instance_valid(phase_timer):
			phase_timer.start()
		tween.tween_callback(_show_gameplay)
	elif pending_discussion_after_reveal:
		pending_discussion_after_reveal = false
		if discussion_turn >= discussion_queue.size():
			tween.tween_callback(_begin_vote_prep)
		else:
			game_phase = "discussion"
			phase_seconds_left = SPEECH_TIME_SECONDS + int(discussion_bonus_seconds.get(discussion_queue[discussion_turn], 0))
			if is_instance_valid(phase_timer):
				phase_timer.start()
			tween.tween_callback(_show_gameplay)
	elif game_phase == "reveal":
		phase_seconds_left = 8
		tween.tween_callback(_resume_reveal_phase_timer)

func _resume_reveal_phase_timer() -> void:
	if game_phase == "reveal" and is_instance_valid(phase_timer):
		phase_timer.start()
	if current_screen == "game":
		_show_gameplay()

