	_button(stack, "НАЙТИ И ВОЙТИ  →", func():
		var entered := code_input.text.strip_edges().to_upper()
		var found := false
		for lobby in created_lobbies:
			if str(lobby.code).to_upper() == entered:
				found = true
				_join_lobby(entered)
				break
		if not found:
			message.text = "Лобби не найдено. Проверь код: в бета-версии доступны только локальные комнаты."
			message.add_theme_color_override("font_color", RED)
	, true)
	_button(page, "← НАЗАД К СПИСКУ ЛОББИ", _show_lobby_browser, false)

func _join_lobby(code: String) -> void:
	for lobby in created_lobbies:
		if str(lobby.code).to_upper() == code.to_upper():
			lobby_code = str(lobby.code)
			last_lobby_code = lobby_code
			if recent_codes.has(lobby_code):
				recent_codes.erase(lobby_code)
			recent_codes.push_front(lobby_code)
			while recent_codes.size() > 5:
				recent_codes.pop_back()
			selected_map = str(lobby.map)
			selected_catastrophe = str(lobby.catastrophe)
			private_lobby = bool(lobby.private)
			player_count = int(lobby.players)
			_show_lobby()
			return

