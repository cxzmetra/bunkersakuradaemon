func _send_scout() -> void:
	if float(bunker_resources.energy) < 10.0 or float(bunker_resources.food) < 5.0:
		game_log.append("Разведка отменена: недостаточно ресурсов для выхода.")
	else:
		bunker_resources.energy = maxf(0.0, float(bunker_resources.energy) - 10.0)
		bunker_resources.food = maxf(0.0, float(bunker_resources.food) - 5.0)
		var outcome := str(_pick(["Разведчик вернулся с запасом воды (+15%).", "Разведка не вернулась. Судьба неизвестна.", "Получены координаты склада. Позже можно будет открыть новую локацию.", "Снаружи обнаружены следы других выживших."]))
		game_log.append(outcome)
		if outcome.contains("(+15%)"):
			bunker_resources.water = minf(100.0, float(bunker_resources.water) + 15.0)
		if outcome.contains("открыть новую локацию") and not unlocked_bunkers.has("Станция K-12"):
			unlocked_bunkers.append("Станция K-12")
			achievements.append("Первый контакт")
	_show_gameplay()

