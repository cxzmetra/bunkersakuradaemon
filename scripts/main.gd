func _clear_screen() -> void:
	# Preserve the page's vertical position when refreshing the SAME screen. The game
	# redraws its table as timers/phases change; this must not throw the player to the top.
	preserve_scroll_on_next_page = current_screen == last_rendered_screen and not last_rendered_screen.is_empty()
	if not preserve_scroll_on_next_page and is_instance_valid(active_reveal_overlay):
		active_reveal_overlay.queue_free()
		active_reveal_overlay = null
	if preserve_scroll_on_next_page:
		for child in get_children():
			if child is ScrollContainer:
				saved_scroll_vertical = child.scroll_vertical
				break
	else:
		saved_scroll_vertical = 0
	# Persistent services must survive screen rebuilds.
	for child in get_children():
		if child == phase_timer or child == profile_file_dialog or child == utility_popup or child == host_popup or child == special_ability_popup or child == active_reveal_overlay:
			continue
		child.queue_free()
	content_root = null

func _background(parent: Control, opacity: float = 0.70) -> void:
	var image := TextureRect.new()
	image.texture = load(BG_PATH)
	image.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	image.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
	image.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	image.mouse_filter = Control.MOUSE_FILTER_IGNORE
	parent.add_child(image)
	var shade := ColorRect.new()
	shade.color = Color(0.025, 0.028, 0.028, opacity)
	shade.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	shade.mouse_filter = Control.MOUSE_FILTER_IGNORE
	parent.add_child(shade)

func _page() -> VBoxContainer:
	var scroll := ScrollContainer.new()
	scroll.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	scroll.offset_left = 24
	scroll.offset_top = 14
	scroll.offset_right = -24
	scroll.offset_bottom = -14
	scroll.mouse_filter = Control.MOUSE_FILTER_STOP
	add_child(scroll)
	var page := VBoxContainer.new()
	page.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	page.size_flags_vertical = Control.SIZE_EXPAND_FILL
	page.custom_minimum_size.y = 0
	page.add_theme_constant_override("separation", 9)
	scroll.add_child(page)
	content_root = page
	last_rendered_screen = current_screen
	if preserve_scroll_on_next_page:
		var restore_to := saved_scroll_vertical
		call_deferred("_restore_page_scroll", scroll, restore_to)
	preserve_scroll_on_next_page = false
	return page

func _restore_page_scroll(scroll: ScrollContainer, position: int) -> void:
	if is_instance_valid(scroll):
		scroll.scroll_vertical = position

