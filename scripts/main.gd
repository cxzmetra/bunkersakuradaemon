func _ready() -> void:
	get_window().title = "БУНКЕР — от sakuradaemon"
	get_window().min_size = Vector2i(1280, 720)
	if DisplayServer.window_get_mode() != DisplayServer.WINDOW_MODE_FULLSCREEN:
		get_window().size = Vector2i(1920, 1080)
	_apply_ui_scale()
	phase_timer = Timer.new()
	phase_timer.wait_time = 1.0
	phase_timer.one_shot = false
	phase_timer.timeout.connect(_on_phase_timer_tick)
	add_child(phase_timer)
	_load_user_settings()
	_show_splash()


func _load_user_settings() -> void:
	var config := ConfigFile.new()
	if config.load("user://bunker_settings.cfg") != OK:
		return
	player_name = str(config.get_value("profile", "nickname", player_name))
	profile_name = player_name
	games_played = int(config.get_value("stats", "games_played", games_played))
	profile_xp = int(config.get_value("profile", "xp", profile_xp))
	profile_level = maxi(1, int(config.get_value("profile", "level", profile_level)))
	desired_survivors = int(config.get_value("game", "desired_survivors", desired_survivors))
	selected_style_mode = str(config.get_value("game", "style_mode", selected_style_mode))
	games_won = int(config.get_value("stats", "games_won", games_won))
	people_saved = int(config.get_value("stats", "people_saved", people_saved))
	people_exiled = int(config.get_value("stats", "people_exiled", people_exiled))
	total_play_seconds = int(config.get_value("stats", "total_play_seconds", total_play_seconds))
	best_survivor_count = int(config.get_value("stats", "best_survivor_count", best_survivor_count))
	master_volume = float(config.get_value("audio", "volume", master_volume))
	fullscreen_enabled = bool(config.get_value("display", "fullscreen", fullscreen_enabled))
	vsync_enabled = bool(config.get_value("display", "vsync", vsync_enabled))
	screen_shake_enabled = bool(config.get_value("interface", "animations", screen_shake_enabled))
	ui_scale = float(config.get_value("interface", "scale", ui_scale))
	bunker_size = str(config.get_value("game", "bunker_size", bunker_size))
	bunker_duration = int(config.get_value("game", "bunker_duration", bunker_duration))
	configured_turn_seconds = int(config.get_value("game", "turn_seconds", configured_turn_seconds))
	configured_discussion_seconds = int(config.get_value("game", "discussion_seconds", configured_discussion_seconds))
	configured_vote_seconds = int(config.get_value("game", "vote_seconds", configured_vote_seconds))
	configured_round_limit = int(config.get_value("game", "round_limit", configured_round_limit))
	random_catastrophe_enabled = bool(config.get_value("game", "random_catastrophe", random_catastrophe_enabled))
	random_bunker_enabled = bool(config.get_value("game", "random_bunker", random_bunker_enabled))
	_apply_ui_scale()
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_ENABLED if vsync_enabled else DisplayServer.VSYNC_DISABLED)
	if fullscreen_enabled:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)
	var saved_avatar_path := str(config.get_value("profile", "avatar_path", ""))
	if not saved_avatar_path.is_empty():
		var saved_image := Image.new()
		if saved_image.load(saved_avatar_path) == OK:
			avatar_path = saved_avatar_path
			avatar_texture = ImageTexture.create_from_image(saved_image)

func _save_user_settings() -> void:
	var config := ConfigFile.new()
	config.set_value("profile", "nickname", player_name)
	config.set_value("profile", "avatar_path", avatar_path)
	config.set_value("profile", "xp", profile_xp)
	config.set_value("profile", "level", profile_level)
	config.set_value("game", "desired_survivors", desired_survivors)
	config.set_value("game", "style_mode", selected_style_mode)
	config.set_value("stats", "games_played", games_played)
	config.set_value("stats", "games_won", games_won)
	config.set_value("stats", "people_saved", people_saved)
	config.set_value("stats", "people_exiled", people_exiled)
