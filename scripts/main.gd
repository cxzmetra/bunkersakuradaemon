	var values: Array = base_values.duplicate()
	if selected_style_mode == "Смешной":
		match category:
			"profession": values.append_array(FUNNY_PROFESSIONS)
			"hobby": values.append_array(FUNNY_HOBBIES)
			"facts": values.append_array(["Однажды выиграл спор у автомата с газировкой", "Носит носок на удачу", "Умеет определять пиццу по запаху", "Считал себя главным героем реалити-шоу", "Собрал коллекцию сломанных пультов", "Умеет делать вид, что понимает инструкции", "Однажды искал очки, пока они были на голове"])
			"trait": values.append_array(["Король драматичных пауз", "Слишком уверен в своей шаурме", "Любит плохие каламбуры", "Панически боится понедельников"])
			"secret": values.append_array(["Тайно съел последний батончик", "Притворяется экспертом по консервам", "Спрятал смешную шляпу", "Однажды проиграл спор голубю"])
			"biology": values.append_array(["28 лет, смеётся в неподходящий момент", "34 года, аллергия на слово «диета»"])
			"baggage": values.append_array(["Гигантская ложка", "Три левых перчатки", "Книга бесполезных рекордов", "Запас жвачки на год"])
			"health": values.append_array(["Острая зависимость от кофе", "Не может проснуться без будильника", "Икота при сильном волнении"])
			"special_condition": values.append_array(["Обязан рассказать самый плохой анекдот", "Один раз может устроить драматическую паузу"])
			"secret_item": values.append_array(["Говорящая резиновая утка", "Пакет сухариков", "Носок неизвестного происхождения"])
			"secret_goal": values.append_array(["Убедить всех, что суп — это напиток", "Найти идеальную подушку"])
			"secret_problem": values.append_array(["Не умеет открывать банки без шума", "Путает право и лево"])
