func _find_person(person_name: String) -> Dictionary:
	for person in game_players:
		if str(person.get("name", "")) == person_name:
			return person
	return {}

func _begin_vote_prep() -> void:
	game_phase = "vote_prep"
	phase_seconds_left = vote_prep_seconds
	if is_instance_valid(phase_timer):
		phase_timer.start()
	game_log.append("Обсуждение завершено. Подготовка к голосованию: 10 секунд.")
	_show_gameplay()

func _begin_vote() -> void:
	game_phase = "vote"
	network_local_vote_confirmed = false
	player_vote_target = ""
	if is_instance_valid(host_popup):
		host_popup.queue_free()
		host_popup = null
	phase_seconds_left = configured_vote_seconds
	vote_confirmed = false
	if phase_timer != null:
		if is_instance_valid(phase_timer):
			phase_timer.start()
	game_log.append("Началось голосование за исключение одного участника.")
	_show_voting_screen()

func _show_voting_screen() -> void:
	current_screen = "voting"
	_clear_screen()
	_background(self, 0.86)
	var page := _page()
	_header(page, "ГОЛОСОВАНИЕ", "РАУНД %d  •  В ЖИВЫХ %d" % [game_round, _alive_count()])
	var vote_timer_label := _label(page, "ОСТАЛОСЬ %02d:%02d" % [floori(float(phase_seconds_left) / 60.0), phase_seconds_left % 60], 17, CYAN)
	network_timer_label = vote_timer_label
	var intro := _panel(page, Color("#101e20"), CYAN)
	_label(intro, "ПЕРЕД ИСКЛЮЧЕНИЕМ", 15, CYAN)
	_label(intro, _vote_prompt(), 14, CREAM)
	var roster := GridContainer.new()
	roster.columns = 2
	roster.add_theme_constant_override("h_separation", 10)
	roster.add_theme_constant_override("v_separation", 8)
	page.add_child(roster)
	if vote_tie_candidates.size() > 0:
		_label(page, "НИЧЬЯ — ДОПОЛНИТЕЛЬНОЕ ГОЛОСОВАНИЕ", 13, ORANGE)
	for person_index in range(game_players.size()):
		var person: Dictionary = game_players[person_index]
		if not bool(person.alive) or str(person.get("name", "")) == player_name:
			continue
		var nm := str(person.name)
		if vote_tie_candidates.size() > 0 and not vote_tie_candidates.has(nm):
			continue
		var card := _panel(roster, Color("#171819"), RED if player_vote_target == nm else BORDER)
		card.custom_minimum_size = Vector2(320, 190)
		var stack := VBoxContainer.new()
		stack.add_theme_constant_override("separation", 5)
		card.add_child(stack)
		var candidate_title := _label(stack, "#%02d  %s" % [person_index + 1, nm], 15, CREAM)
		candidate_title.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		var profession_line := _label(stack, "Профессия: " + (str(person.get("profession", "неизвестно")) if person.get("revealed", []).has("Профессия") else "???"), 11, ORANGE)
		profession_line.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		var revealed_lines: Array[String] = []
		for category in CARD_CATEGORIES:
			if person.get("revealed", []).has(category) and category != "Профессия":
				var revealed_value := str(person.get(_category_key(str(category)), "—"))
				revealed_lines.append(str(category) + ": " + revealed_value)
		if revealed_lines.is_empty():
			_label(stack, "Дополнительные характеристики пока не раскрыты", 10, MUTED)
		else:
			var revealed_label := _label(stack, "ОТКРЫТЫЕ ДАННЫЕ\n" + "\n".join(revealed_lines), 10, CREAM)
			revealed_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			revealed_label.custom_minimum_size.y = 64
		_label(stack, "Полезность: " + str(person.get("score", 0)), 11, GREEN if int(person.get("score", 0)) >= 2 else RED)
		var reason_label := _label(stack, _reason_for_vote(person), 10, MUTED)
		reason_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		var local_vote_done := (network_client_active and network_local_vote_confirmed) or (not network_client_active and vote_confirmed)
		if not local_vote_done:
			_button(stack, "ВЫБРАТЬ" if player_vote_target != nm else "✓ ВЫБРАН", func(): _select_vote_target(nm), player_vote_target == nm)
		else:
			_label(stack, "ТВОЙ ВЫБОР" if player_vote_target == nm else "ОЖИДАНИЕ РЕЗУЛЬТАТА", 10, MUTED)
	var local_vote_done_page := (network_client_active and network_local_vote_confirmed) or (not network_client_active and vote_confirmed)
	if not local_vote_done_page:
		_button(page, "ПОДТВЕРДИТЬ ГОЛОС", _confirm_vote, true)
	elif network_client_active:
		_label(page, "ГОЛОС ПЕРЕДАН ХОСТУ • ОЖИДАНИЕ РЕЗУЛЬТАТА", 11, CYAN)
	elif network_is_host:
		_button(page, "ПОКАЗАТЬ РЕЗУЛЬТАТ ГОЛОСОВАНИЯ", _resolve_vote, true)

func _select_vote_target(target: String) -> void:
	if network_client_active and network_local_vote_confirmed:
		return
	if not network_client_active and vote_confirmed:
		return
	player_vote_target = target
	_show_voting_screen()

func _confirm_vote() -> void:
	if network_client_active:
		if player_vote_target.is_empty():
			game_log.append("Сначала выбери участника для голосования.")
			_show_voting_screen()
			return
		_send_network_action({"action":"vote", "target":player_vote_target})
		network_local_vote_confirmed = true
		_show_voting_screen()
		return
	if player_vote_target.is_empty():
		game_log.append("Сначала выбери участника для голосования.")
		_show_voting_screen()
		return
	vote_confirmed = true
	if phase_timer != null and not (network_connected and network_is_host):
		if is_instance_valid(phase_timer):
			phase_timer.stop()
	vote_choices[player_name] = player_vote_target
	_show_voting_screen()

func _resolve_vote() -> void:
	var alive: Array[Dictionary] = []
	for person in game_players:
		if bool(person.alive):
			alive.append(person)
	if alive.size() <= 2:
		_finish_game()
		return
	var votes: Dictionary = {}
	for voter_name in vote_choices.keys():
		if blocked_vote_names.has(str(voter_name)):
			game_log.append("Голос %s заблокирован спецспособностью." % str(voter_name))
			continue
		var submitted_target := str(vote_choices[voter_name])
		if not submitted_target.is_empty() and _find_person(submitted_target).get("alive", false):
			votes[submitted_target] = int(votes.get(submitted_target, 0)) + 1
	if not network_connected and player_vote_target != "" and not vote_choices.has(player_name):
		votes[player_vote_target] = int(votes.get(player_vote_target, 0)) + 1
	for person in alive:
		if bool(person.is_human):
			continue
		var ai_target := _choose_ai_vote_target()
		if ai_target == "":
			continue
		votes[ai_target] = int(votes.get(ai_target, 0)) + 1
	var max_votes := 0
	for vote_name in votes.keys():
		max_votes = maxi(max_votes, int(votes[vote_name]))
	var leaders: Array[String] = []
	for vote_name in votes.keys():
		if int(votes[vote_name]) == max_votes:
			leaders.append(str(vote_name))
	if leaders.size() > 1 and vote_tie_candidates.is_empty():
		vote_tie_candidates = leaders
		vote_confirmed = false
		vote_choices.clear()
		game_log.append("Ничья между участниками: " + ", ".join(PackedStringArray(leaders)) + ". Требуется переголосование.")
		game_phase = "vote"
		phase_seconds_left = configured_vote_seconds
		if is_instance_valid(phase_timer):
			phase_timer.start()
		_show_voting_screen()
		return
	var winner := ""
	if leaders.size() > 1:
		winner = leaders[randi_range(0, leaders.size() - 1)]
	elif not leaders.is_empty():
		winner = leaders[0]
	if winner != "":
		var protected_person := _find_person(winner)
		if bool(protected_person.get("protected_next_vote", false)):
			protected_person["protected_next_vote"] = false
			game_log.append("Защита сработала: %s остаётся в бункере." % winner)
			winner = ""
	if winner == "":
		game_log.append("Голосование не исключило участника; партия продолжается.")
		game_phase = "result"
		phase_seconds_left = 5
		if is_instance_valid(phase_timer): phase_timer.start()
		_show_gameplay()
		return
	game_log.append("БЮЛЛЕТЕНИ ГОЛОСОВАНИЯ:")
	for voter in vote_choices.keys():
		game_log.append(str(voter) + " → " + str(vote_choices[voter]))
	game_log.append("Итог: %s получает %d голосов." % [winner, max_votes])
	blocked_vote_names.clear()
	for i in range(game_players.size()):
		if str(game_players[i].name) == winner and bool(game_players[i].alive):
			game_players[i].alive = false
			game_players[i].revealed = CARD_CATEGORIES.duplicate()
			if bool(game_players[i].is_human) and str(game_players[i].get("name", "")) == player_name and not network_connected:
				people_exiled += 1
				_save_user_settings()
				game_end_reason = "Ты был исключён голосованием."
				_show_elimination_scene(winner, max_votes)
				_finish_game()
				return
		people_exiled += 1
		_save_user_settings()
		game_log.append("%s исключён голосованием." % winner)
		break
	vote_tie_candidates.clear()
	vote_confirmed = false
	vote_choices.clear()
	game_round += 1
	_advance_bunker_simulation()
	if game_round > configured_round_limit:
		game_end_reason = "Достигнут лимит раундов. Состав бункера зафиксирован по числу оставшихся участников."
		_finish_game()
		return
	if _alive_count() <= bunker_capacity:
		game_end_reason = "Группа определила состав, помещающийся в бункере."
		_finish_game()
		return
	if _alive_count() <= 2:
		_finish_game()
		return
	game_phase = "result"
	phase_seconds_left = 5
	if is_instance_valid(phase_timer):
		phase_timer.start()
	_show_elimination_scene(winner, max_votes)

func _show_elimination_scene(winner: String, votes: int) -> void:
	elimination_winner = winner
	elimination_votes = votes
	current_screen = "elimination"
	_clear_screen()
	_background(self, 0.92)
	var page := _page()
	var panel := _panel(page, Color("#120b0c"), RED)
	var stack := VBoxContainer.new()
	stack.add_theme_constant_override("separation", 12)
	panel.add_child(stack)
	_label(stack, "ПРОТОКОЛ ИСКЛЮЧЕНИЯ", 13, RED)
	_label(stack, winner.to_upper(), 30, CREAM)
	_label(stack, "Группа приняла решение. Голосов: %d." % votes, 16, ORANGE)
	_label(stack, "Осталось в живых: %d из %d. Мест в бункере: %d." % [_alive_count(), player_count, bunker_capacity], 14, CREAM)
	_label(stack, _reason_for_named_person(winner), 13, MUTED)
	var tween := create_tween()
	panel.modulate.a = 0.15
	tween.tween_property(panel, "modulate:a", 1.0, 0.55)
	if game_end_reason != "":
		_button(stack, "К ИТОГАМ ПАРТИИ", _finish_game, true)
	else:
		_button(stack, "ПРОДОЛЖИТЬ", _show_gameplay, true)
		_button(stack, "ЗАВЕРШИТЬ ПАРТИЮ", _end_game, false)

func _vote_prompt() -> String:
	var target := _find_person(player_vote_target)
	if target.is_empty():
		return "Группа должна решить, кто получит последнее предупреждение и будет исключён."
	return "%s: %s. Группа обсуждает полезность, риски и скрытые мотивы." % [player_vote_target, _reason_for_vote(target)]

func _reason_for_vote(person: Dictionary) -> String:
	var parts: Array[String] = []
	if int(person.get("score", 0)) < 0:
		parts.append("низкая выживаемость")
	if str(person.get("health", "")).to_lower().contains("болез"):
		parts.append("риск для здоровья группы")
	if int(person.get("suspicion", 0)) >= 3:
		parts.append("подозрительное поведение")
	if parts.is_empty():
		parts.append("неясная польза для группы")
	return "Причина: " + ", ".join(PackedStringArray(parts))

func _reason_for_named_person(nm: String) -> String:
	return _reason_for_vote(_find_person(nm))

func _choose_ai_vote_target() -> String:
	var candidates: Array[Dictionary] = []
	for person in game_players:
		if bool(person.alive) and not bool(person.is_human):
			candidates.append(person)
	if candidates.is_empty(): return ""
	candidates.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return int(a.score) < int(b.score))
	var weak_count := mini(3, candidates.size())
	return str(candidates[randi_range(0, weak_count - 1)].name)

func _next_round() -> void:
	game_phase = "discussion"
	discussion_turn = 0
	discussion_revealed_this_turn.clear()
	discussion_queue.clear()
	discussion_statements.clear()
	for person in game_players:
		if bool(person.alive):
			discussion_queue.append(str(person.name))
	phase_seconds_left = configured_turn_seconds
	if is_instance_valid(phase_timer):
		phase_timer.start()
	game_log.append("Раунд %d: группа пересматривает состав, ресурсы и состояние отсеков." % game_round)
	_show_gameplay()

func _alive_count() -> int:
	var count := 0
	for person in game_players:
		if bool(person.alive): count += 1
	return count

func _ensure_one_hidden_card_at_end() -> void:
	for i in range(game_players.size()):
		var person: Dictionary = game_players[i]
		var opened: Array = person.get("revealed", [])
		if not opened.has("Профессия"):
			opened.append("Профессия")
		var closed: Array[String] = []
		for category in CARD_CATEGORIES:
			if not opened.has(category): closed.append(str(category))
		# Preserve one unknown card and reveal the rest for the final dossier.
		if closed.size() > 1:
			var keep_hidden := str(_pick(closed))
			for category in closed:
				if category != keep_hidden: opened.append(category)
		person["revealed"] = opened
		game_players[i] = person
		if bool(person.get("is_human", false)):
			human_revealed_categories.clear()
			for category in opened:
				if not human_revealed_categories.has(str(category)): human_revealed_categories.append(str(category))
	game_log.append("Финальные досье раскрыты: у каждого участника осталась одна закрытая характеристика.")

func _award_profile_xp(amount: int) -> void:
	profile_xp += maxi(0, amount)
	while profile_xp >= profile_level * 100:
		profile_xp -= profile_level * 100
		profile_level += 1
		game_log.append("Уровень профиля повышен: %d." % profile_level)
	_save_user_settings()

func _open_special_abilities() -> void:
	if game_players.is_empty(): return
	var human: Dictionary = _find_person(player_name)
	if human.is_empty(): return
	if network_client_active:
		_send_network_action({"action":"ability_open"})
	var abilities: Array = human.get("special_abilities", [])
	var used: Array = human.get("special_used", [])
	game_paused = true
	special_ability_resume_timer = is_instance_valid(phase_timer) and phase_timer.time_left > 0.0
	if is_instance_valid(phase_timer): phase_timer.stop()
	if is_instance_valid(special_ability_popup): special_ability_popup.queue_free()
	special_ability_popup = AcceptDialog.new()
	special_ability_popup.title = "СПЕЦВОЗМОЖНОСТИ — ИГРА НА ПАУЗЕ"
	special_ability_popup.dialog_text = "У тебя две уникальные возможности на партию. Выбери одну; таймер остановлен на время применения."
	add_child(special_ability_popup)
	for ability in abilities:
		var ability_name := str(ability)
		var button_text := ability_name + ("  •  ИСПОЛЬЗОВАНО" if used.has(ability_name) else "")
		special_ability_popup.add_button(button_text, false, ability_name)
	special_ability_popup.add_button("ОТМЕНА", true, "cancel")
	special_ability_popup.custom_action.connect(_on_special_ability_action)
	special_ability_popup.confirmed.connect(_close_special_ability_popup)
	special_ability_popup.popup_centered()

func _on_special_ability_action(action: String) -> void:
	if action == "cancel":
		if network_client_active: _send_network_action({"action":"ability_cancel"})
		_close_special_ability_popup()
		return
	if network_client_active:
		_send_network_action({"action":"ability", "ability":action})
		_close_special_ability_popup()
		return
	if game_players.is_empty(): return
	var human: Dictionary = game_players[0]
	var used: Array = human.get("special_used", [])
	if used.has(action):
		if is_instance_valid(special_ability_popup): special_ability_popup.dialog_text = "Эта возможность уже использована. Выбери другую или нажми отмену."
		return
	used.append(action)
	human["special_used"] = used
	var hidden: Array[String] = []
	for category in CARD_CATEGORIES:
		if category != "Профессия" and not human.get("revealed", []).has(category): hidden.append(category)
	match action:
		"Дополнительное место":
			bunker_capacity += 1
			game_log.append("Способность: вместимость бункера увеличена на 1.")
		"Сканирование чужого досье", "Принудительное раскрытие":
			var targets: Array[Dictionary] = []
			for person in game_players:
				if bool(person.get("alive", true)) and str(person.get("name", "")) != player_name: targets.append(person)
			if not targets.is_empty():
				var target_person: Dictionary = targets.pick_random()
				var target_hidden: Array[String] = []
				for target_category in CARD_CATEGORIES:
					if target_category != "Профессия" and not target_person.get("revealed", []).has(target_category): target_hidden.append(target_category)
				if not target_hidden.is_empty():
					var chosen_category: String = target_hidden.pick_random()
					var opened: Array = target_person.get("revealed", [])
					opened.append(chosen_category)
					target_person["revealed"] = opened
					var target_name_for_reveal := str(target_person.get("name", "Участник"))
					var target_value_for_reveal := str(target_person.get(_category_key(chosen_category), "—"))
					network_last_reveal = {"id":"%d|%s|%s|%d" % [game_round, target_name_for_reveal, chosen_category, Time.get_ticks_msec()], "name":target_name_for_reveal, "category":chosen_category, "value":target_value_for_reveal}
					game_log.append("Способность раскрыла %s: %s." % [target_name_for_reveal, chosen_category])
					_show_character_reveal_splash(target_name_for_reveal, chosen_category, target_value_for_reveal)
		"Дополнительные 30 секунд": phase_seconds_left += 30
		"Защита от исключения":
			human["protected_next_vote"] = true
			game_log.append("Защита активна до следующего результата голосования.")
		"Перегенерация своей карты", "Перемешать характеристики":
			if not hidden.is_empty():
				var chosen: String = hidden.pick_random()
				human[_category_key(chosen)] = _random_value_for_category(chosen)
				game_log.append("Обновлено значение скрытой характеристики: %s." % chosen)
		"Стабилизация ресурсов", "Ремонт бункера":
			for resource_key in bunker_resources.keys(): bunker_resources[resource_key] = minf(100.0, float(bunker_resources[resource_key]) + 20.0)
			game_log.append("Часть ресурсов бункера восстановлена.")
		"Аварийный запас":
			bunker_resources["food"] = minf(100.0, float(bunker_resources.get("food", 0.0)) + 30.0)
			bunker_resources["water"] = minf(100.0, float(bunker_resources.get("water", 0.0)) + 20.0)
		"Переголосование":
			if game_phase == "vote":
				vote_choices.clear()
				vote_confirmed = false
				phase_seconds_left = configured_vote_seconds
				game_log.append("Голосование сброшено и начнётся заново.")
		"Отмена собственного голоса": vote_choices.erase(player_name)
		"Скрыть свою характеристику":
			var opened_self: Array = human.get("revealed", [])
			var eligible_open: Array[String] = []
			for opened_category in opened_self:
				if str(opened_category) != "Профессия": eligible_open.append(str(opened_category))
			if not eligible_open.is_empty():
				var hidden_category: String = eligible_open.pick_random()
				opened_self.erase(hidden_category)
				human["revealed"] = opened_self
				human_revealed_categories.erase(hidden_category)
		"Проверка катастрофы": game_log.append("Приоритеты: " + str(current_game_catastrophe.get("effect", "Проверь условия бункера.")))
		"Второй шанс":
			if not hidden.is_empty():
				var second_chance: String = hidden.pick_random()
				var opened_again: Array = human.get("revealed", [])
				opened_again.append(second_chance)
				human["revealed"] = opened_again
		"Блокировка одного голоса":
			var block_candidates: Array[String] = []
			for person in game_players:
				var candidate_name := str(person.get("name", ""))
				if bool(person.get("alive", true)) and candidate_name != player_name and not block_candidates.has(candidate_name): block_candidates.append(candidate_name)
			if not block_candidates.is_empty():
				var blocked_name := str(block_candidates.pick_random())
				if not blocked_vote_names.has(blocked_name): blocked_vote_names.append(blocked_name)
				game_log.append("Следующий голос участника %s заблокирован." % blocked_name)
	game_players[0] = human
	_close_special_ability_popup()
	_show_gameplay()

func _apply_network_special_ability(sender: String, ability_name: String) -> void:
	var ability_owner := _find_person(sender)
	if ability_owner.is_empty() or not bool(ability_owner.get("alive", true)):
		return
	var abilities: Array = ability_owner.get("special_abilities", [])
	var used: Array = ability_owner.get("special_used", [])
	if not abilities.has(ability_name) or used.has(ability_name):
		return
	var was_paused := game_paused
	var timer_was_running := network_ability_timer_was_running or (is_instance_valid(phase_timer) and not phase_timer.is_stopped())
	game_paused = true
	if is_instance_valid(phase_timer): phase_timer.stop()
	used.append(ability_name)
	ability_owner["special_used"] = used
	var hidden: Array[String] = []
	for category in CARD_CATEGORIES:
		if category != "Профессия" and not ability_owner.get("revealed", []).has(category): hidden.append(str(category))
	match ability_name:
		"Дополнительное место":
			bunker_capacity += 1
			game_log.append("%s использовал способность: вместимость +1." % sender)
		"Сканирование чужого досье", "Принудительное раскрытие":
			var reveal_targets: Array[Dictionary] = []
			for person in game_players:
				if bool(person.get("alive", true)) and str(person.get("name", "")) != sender: reveal_targets.append(person)
			if not reveal_targets.is_empty():
				var target_person: Dictionary = reveal_targets.pick_random()
				var closed: Array[String] = []
				for category in CARD_CATEGORIES:
					if category != "Профессия" and not target_person.get("revealed", []).has(category): closed.append(str(category))
				if not closed.is_empty():
					var chosen_reveal_category: String = closed.pick_random()
					target_person["revealed"].append(chosen_reveal_category)
					for i in range(game_players.size()):
						if str(game_players[i].get("name", "")) == str(target_person.get("name", "")): game_players[i] = target_person
					var val := str(target_person.get(_category_key(chosen_reveal_category), "—"))
					network_last_reveal = {"id":"%d|%s|%s|%d" % [game_round, str(target_person.get("name", "")), chosen_reveal_category, Time.get_ticks_msec()], "name":str(target_person.get("name", "")), "category":chosen_reveal_category, "value":val}
					game_log.append("Способность %s раскрыла характеристику %s: %s." % [sender, str(target_person.get("name", "")), chosen_reveal_category])
		"Дополнительные 30 секунд":
			phase_seconds_left += 30
		"Защита от исключения", "Второй шанс":
			ability_owner["protected_next_vote"] = true
			game_log.append("%s получил защиту от следующего исключения." % sender)
		"Перегенерация своей карты", "Перемешать характеристики":
			if not hidden.is_empty():
				var chosen_regen_category: String = hidden.pick_random()
				ability_owner[_category_key(chosen_regen_category)] = _random_value_for_category(chosen_regen_category)
				game_log.append("%s обновил скрытую характеристику «%s»." % [sender, chosen_regen_category])
		"Стабилизация ресурсов", "Ремонт бункера":
			for key in bunker_resources.keys(): bunker_resources[key] = minf(100.0, float(bunker_resources[key]) + 20.0)
			game_log.append("%s восстановил системы бункера." % sender)
		"Аварийный запас":
			bunker_resources["food"] = minf(100.0, float(bunker_resources.get("food", 0.0)) + 30.0)
			bunker_resources["water"] = minf(100.0, float(bunker_resources.get("water", 0.0)) + 20.0)
		"Переголосование":
			if game_phase == "vote":
				vote_choices.clear()
				vote_confirmed = false
				phase_seconds_left = configured_vote_seconds
				game_log.append("%s инициировал повторное голосование." % sender)
		"Отмена собственного голоса":
			vote_choices.erase(sender)
		"Скрыть свою характеристику":
			var opened: Array = ability_owner.get("revealed", [])
			var eligible: Array[String] = []
			for category in opened:
				if str(category) != "Профессия": eligible.append(str(category))
			if not eligible.is_empty(): opened.erase(eligible.pick_random())
			ability_owner["revealed"] = opened
		"Проверка катастрофы":
			game_log.append("%s проверил протокол катастрофы: %s" % [sender, str(current_game_catastrophe.get("effect", "изучите сводку"))])
		"Блокировка одного голоса":
			var block_targets: Array[String] = []
			for person in game_players:
				if bool(person.get("alive", true)) and str(person.get("name", "")) != sender and not block_targets.has(str(person.get("name", ""))): block_targets.append(str(person.get("name", "")))
			if not block_targets.is_empty():
				var blocked := str(block_targets.pick_random())
				if not blocked_vote_names.has(blocked): blocked_vote_names.append(blocked)
				game_log.append("Следующий голос участника %s заблокирован." % blocked)
	for i in range(game_players.size()):
		if str(game_players[i].get("name", "")) == sender:
			game_players[i] = ability_owner
			break
	game_log.append("%s использовал спецвозможность: %s." % [sender, ability_name])
	game_paused = false
	network_ability_timer_was_running = false
	if timer_was_running and is_instance_valid(phase_timer) and game_session_active: phase_timer.start()
	elif was_paused and not timer_was_running: game_paused = true
	_show_gameplay()
	_broadcast_network_game_state(true)

func _close_special_ability_popup() -> void:
	if is_instance_valid(special_ability_popup): special_ability_popup.queue_free()
	game_paused = false
	if not network_client_active and special_ability_resume_timer and is_instance_valid(phase_timer) and game_session_active:
		phase_timer.start()
	_show_gameplay()

func _finish_game() -> void:
	if game_finished:
		_show_gameplay()
		return
	_award_profile_xp(50 + _alive_count() * 10)
	_ensure_one_hidden_card_at_end()
	game_finished = true
	game_phase = "finished"
	if phase_timer != null:
		if is_instance_valid(phase_timer):
			phase_timer.stop()
	if not game_players.is_empty() and bool(game_players[0].alive):
		games_won += 1
		people_saved += _alive_count()
		best_survivor_count = maxi(best_survivor_count, _alive_count())
		_save_user_settings()
		if not achievements.has("Первое выживание"):
			achievements.append("Первое выживание")
		game_log.append("Ты пережил катастрофу. В бункере осталось %d человек." % _alive_count())
	else:
		game_log.append("Ты не пережил отбор. Попробуй изменить стратегию.")
	_show_gameplay()

func _show_game_result(page: VBoxContainer) -> void:
	var human_alive := not game_players.is_empty() and bool(game_players[0].alive)
	var result_panel := _panel(page, Color("#0b0d0e"), GREEN if human_alive else RED)
	var stack := VBoxContainer.new()
	stack.add_theme_constant_override("separation", 8)
	result_panel.add_child(stack)
	var ending_title := "ТЫ ВЫЖИЛ" if human_alive else "ТЫ ИСКЛЮЧЁН"
	if game_end_reason.contains("жизнеобеспечения"):
		ending_title = "АВАРИЯ БУНКЕРА"
	elif _alive_count() <= bunker_capacity and human_alive:
		ending_title = "СОСТАВ БУНКЕРА УТВЕРЖДЁН"
	_label(stack, ending_title, 30, GREEN if human_alive else RED)
	_label(stack, "Катастрофа: " + selected_catastrophe, 14, CREAM)
	_label(stack, _catastrophe_story(), 13, CREAM)
	_label(stack, "В живых: %d из %d участников. Мест в бункере: %d." % [_alive_count(), player_count, bunker_capacity], 13, MUTED)
	_label(stack, "Исключено: %d  •  Раунд: %d" % [people_exiled, game_round], 12, MUTED)
	_label(stack, "Причина завершения: " + (game_end_reason if game_end_reason != "" else ("Группа укомплектована" if _alive_count() <= bunker_capacity else "Отбор завершён")), 13, CREAM)
	_label(stack, "Итог партии: %s" % ("победа" if human_alive else "поражение"), 15, ORANGE)
	_label(stack, "Достижения: " + (", ".join(PackedStringArray(achievements)) if not achievements.is_empty() else "пока нет"), 11, MUTED)
	_button(stack, "НОВАЯ ПАРТИЯ", _start_game, true)
	_button(stack, "ВЕРНУТЬСЯ В ЛОББИ", _show_lobby, false)
	_button(stack, "В ГЛАВНОЕ МЕНЮ", _show_main_menu, false)

func _end_game() -> void:
	_finish_game()

